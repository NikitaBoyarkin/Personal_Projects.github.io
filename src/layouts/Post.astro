---
import Base from './Base.astro';
import InnerTOC from '../components/InnerTOC.astro';
import { formatDate, estimateReadTime } from '../lib/date';
import { withBase } from '../lib/path';

interface Props {
  title: string;
  date: Date;
  category: string;
  excerpt: string;
  slug: string;
  image?: string;
  related?: { href: string; title: string }[];
  keywords?: string[];
  prev?: { href: string; title: string } | null;
  next?: { href: string; title: string } | null;
}

const { title, date, category, excerpt, slug, image, related = [], keywords = [], prev = null, next = null } = Astro.props;
const rendered = await Astro.slots.render('default');
const readTime = estimateReadTime(rendered.replace(/<[^>]*>/g, ' '));
const categoryDisplay = category.replace('-', ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const siteUrl = (Astro.site?.toString() || 'https://nikitaboyarkin.github.io').replace(/\/$/, '');
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: excerpt,
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  articleSection: category,
  image: image ? `${siteUrl}${withBase(image)}` : undefined,
  author: { '@type': 'Person', name: 'Nikita Boyarkin', url: `${siteUrl}${withBase('/')}` },
  publisher: { '@type': 'Person', name: 'Nikita Boyarkin' },
  mainEntityOfPage: `${siteUrl}${withBase(`posts/${slug}/`)}`,
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}${withBase('/')}` },
    { '@type': 'ListItem', position: 2, name: 'Writing', item: `${siteUrl}${withBase('writing/')}` },
    { '@type': 'ListItem', position: 3, name: title, item: `${siteUrl}${withBase(`posts/${slug}/`)}` },
  ],
};
const articleJsonLdGraph = { '@context': 'https://schema.org', '@graph': [articleJsonLd, breadcrumbJsonLd] };
---

<Base
  title={`${title} | Nikita Boyarkin`}
  description={excerpt}
  keywords={keywords}
  ogImage={image}
  ogType="article"
  activeNav="writing"
  canonical={withBase(`posts/${slug}/`)}
  lang="ru"
  jsonLd={articleJsonLdGraph}
>
  <InnerTOC selector="#post-content" lang="ru" />

  <article class="post-content">
    <header class="post-header reveal">
      <span class="post-tag">{categoryDisplay}</span>
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">{formatDate(date)} · {readTime} мин чтения · Nikita Boyarkin</div>
    </header>

    <div class="post-body" id="post-content">
      <slot />
    </div>

    {related.length > 0 && (
      <section class="post-related reveal reveal-delay-2" aria-label="Связанные материалы">
        <h2>Смотрите также</h2>
        <ul>
          {related.map((r) => (
            <li><a href={r.href}>{r.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    {(prev || next) && (
      <nav class="prev-next" aria-label="Другие записи">
        {prev && (
          <a class="pn-link pn-prev" href={prev.href}>
            <span class="pn-dir">← Предыдущая</span>
            <span class="pn-title">{prev.title}</span>
          </a>
        )}
        {next && (
          <a class="pn-link pn-next" href={next.href}>
            <span class="pn-dir">Следующая →</span>
            <span class="pn-title">{next.title}</span>
          </a>
        )}
      </nav>
    )}

    <a href={withBase('writing/')} class="post-back">← К статьям</a>
  </article>
</Base>
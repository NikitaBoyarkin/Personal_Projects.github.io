---
import Base from './Base.astro';
import InnerTOC from '../components/InnerTOC.astro';
import { formatDate, estimateReadTime } from '../lib/date';
import { withBase } from '../lib/path';

interface Props {
  title: string;
  date: Date;
  category: string;
  excerpt: string;
  slug: string;
  image?: string;
  related?: { href: string; title: string }[];
  keywords?: string[];
}

const { title, date, category, excerpt, slug, image, related = [], keywords = [] } = Astro.props;
const rendered = await Astro.slots.render('default');
const readTime = estimateReadTime(rendered.replace(/<[^>]*>/g, ' '));
const categoryDisplay = category.replace('-', ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const siteUrl = (Astro.site?.toString() || 'https://nikitaboyarkin.github.io').replace(/\/$/, '');
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: excerpt,
  datePublished: date.toISOString(),
  author: { '@type': 'Person', name: 'Nikita Boyarkin', url: `${siteUrl}${withBase('/')}` },
  publisher: { '@type': 'Person', name: 'Nikita Boyarkin' },
  mainEntityOfPage: `${siteUrl}${withBase(`posts/${slug}/`)}`,
};
---

<Base
  title={`${title} | Nikita Boyarkin`}
  description={excerpt}
  keywords={keywords}
  ogImage={image}
  ogType="article"
  activeNav="writing"
  canonical={withBase(`posts/${slug}/`)}
  lang="ru"
  jsonLd={articleJsonLd}
>
  <InnerTOC selector="#post-content" />

  <article class="post-content">
    <header class="post-header reveal">
      <span class="post-tag">{categoryDisplay}</span>
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">{formatDate(date)} · {readTime} min read · Nikita Boyarkin</div>
    </header>

    <div class="post-body" id="post-content">
      <slot />
    </div>

    {related.length > 0 && (
      <section class="post-related reveal reveal-delay-2" aria-label="Связанные материалы">
        <h2>Смотрите также</h2>
        <ul>
          {related.map((r) => (
            <li><a href={r.href}>{r.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    <a href={withBase('writing/')} class="post-back">← Back to Writing</a>
  </article>
</Base>
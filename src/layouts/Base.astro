---
import '../styles/global.css';
import '../styles/blog.css';
import { withBase } from '../lib/path';
import Analytics from '../components/Analytics.astro';
import LangSwitch from '../components/LangSwitch.astro';
import SearchBox from '../components/SearchBox.astro';
import MorphIcon from 'morphicons/astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  ogType?: 'website' | 'article';
  ogImage?: string;
  canonical?: string;
  activeNav?: 'writing' | 'contact' | 'home' | 'about';
  jsonLd?: Record<string, unknown>;
  lang?: 'ru' | 'en';
  counterpartHref?: string;
}

const {
  title,
  description = 'Nikita Boyarkin — Data Analyst / Product Analyst portfolio. SQL, Python, Visualization, A/B Testing.',
  keywords = [],
  ogType = 'website',
  ogImage = '/images/og/portfolio-banner.png',
  canonical,
  activeNav = 'home',
  jsonLd,
  lang = 'ru',
  counterpartHref,
} = Astro.props;

const siteUrl = (Astro.site?.toString() || 'https://nikitaboyarkin.github.io').replace(/\/$/, '');
const pageUrl = canonical ? `${siteUrl}${canonical}` : Astro.url.toString();
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${withBase(ogImage)}`;
const faviconUrl = withBase('favicon.svg');

// i18n: locale-aware nav hrefs + hreflang alternates.
const isEn = lang === 'en';
const homeHref = isEn ? withBase('en/') : withBase('/');
const aboutHref = isEn ? withBase('en/about/') : withBase('about/');
const projectsHref = isEn ? withBase('en/#projects') : withBase('#projects');
const writingHref = isEn ? withBase('en/writing/') : withBase('writing/');
const contactHref = isEn ? withBase('en/contact/') : withBase('contact/');
const startHref = isEn ? withBase('en/start/') : withBase('start/');
const graphHref = isEn ? withBase('en/graph/') : withBase('graph/');
const gamesHref = withBase('games/'); // static page in public/, no EN route

// i18n: header / footer chrome labels.
const t = {
  skip: isEn ? 'Skip to content' : 'Перейти к содержимому',
  navStart: isEn ? 'Start here' : 'С чего начать',
  navProjects: isEn ? 'Projects' : 'Проекты',
  navWriting: isEn ? 'Writing' : 'Статьи',
  navGraph: isEn ? 'Graph' : 'Граф',
  navAbout: isEn ? 'About' : 'Обо мне',
  navContact: isEn ? 'Contact' : 'Контакты',
  footerCv: isEn ? 'CV' : 'Резюме',
  footerWriting: isEn ? 'Writing' : 'Статьи',
  themeTitle: isEn ? 'Theme: dark / light / cyberpunk' : 'Тема: тёмная / светлая / киберпанк',
  themeLabel: isEn ? 'Theme: ' : 'Тема: ',
  themeCycle: isEn ? '. Click to cycle.' : '. Нажмите для смены.',
};

const counterpartUrl = counterpartHref ? `${siteUrl}${counterpartHref}` : null;
const ruAltUrl = isEn ? counterpartUrl : pageUrl;
const enAltUrl = isEn ? pageUrl : counterpartUrl;

// Theme-toggle icons (lucide-style stroke paths, 24×24). Moved to plain
// `d` strings so morphicons can animate between them without a lucide dep.
const THEME_MOON = 'M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z';
const THEME_SUN =
  'M12 7a5 5 0 1 0 0 10a5 5 0 1 0 0-10M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42';
const THEME_CYBER = 'M13 2 3 14 12 14 11 22 21 10 12 10 13 2z';
const NAV_MENU = 'M4 6h16M4 12h16M4 18h16';
const NAV_CLOSE = 'M6 6l12 12M6 18L18 6';
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    {canonical && <link rel="canonical" href={pageUrl} />}

    {counterpartUrl && ruAltUrl && <link rel="alternate" hreflang="ru" href={ruAltUrl} />}
    {counterpartUrl && enAltUrl && <link rel="alternate" hreflang="en" href={enAltUrl} />}
    {counterpartUrl && ruAltUrl && <link rel="alternate" hreflang="x-default" href={ruAltUrl} />}

    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="apple-touch-icon" href={faviconUrl} />
    <link rel="alternate" type="application/rss+xml" title="Nikita Boyarkin — Writing" href={withBase('rss.xml')} />
    <meta id="theme-color" name="theme-color" content="#0f2a2b" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={fullOgImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    {
      jsonLd && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }

    <script is:inline>
      // Prevent theme flash: apply saved or preferred theme before first paint.
      // Three themes: dark (default), light, cyberpunk.
      (function () {
        const html = document.documentElement;
        const themeColorMeta = document.querySelector('meta[name="theme-color"]');
        const THEME_COLORS = { dark: '#0f2a2b', light: '#f4efca', cyberpunk: '#0a0a12' };
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        let theme = prefersDark ? 'dark' : 'light';
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light' || saved === 'cyberpunk') theme = saved;
        } catch (e) {
          // localStorage may be unavailable
        }
        html.setAttribute('data-theme', theme);
        if (themeColorMeta) themeColorMeta.setAttribute('content', THEME_COLORS[theme] || THEME_COLORS.dark);
      })();
    </script>

    <Analytics />
  </head>

  <body>
    <a href="#main" class="skip-link">{t.skip}</a>

    <nav aria-label={isEn ? 'Main navigation' : 'Основная навигация'}>
      <a href={homeHref} class="nav-brand">
        <svg class="nav-logo" aria-hidden="true" viewBox="0 0 100 100" width="28" height="28">
          <path class="cell" d="M96 50 73 89.8 27 89.8 4 50 27 10.2 73 10.2Z"/>
          <text class="mono" x="50" y="61" font-family="Inter, system-ui, sans-serif" font-size="30" font-weight="700" letter-spacing="-0.5" text-anchor="middle">NB</text>
        </svg>
        <b>{isEn ? 'Portfolio' : 'Портфолио'}</b>
      </a>
      <ul class="links" id="nav-links">
        <li><a href={startHref}>{t.navStart}</a></li>
        <li><a href={projectsHref}>{t.navProjects}</a></li>
        <li><a href={writingHref} class={activeNav === 'writing' ? 'active' : ''} aria-current={activeNav === 'writing' ? 'page' : undefined}>{t.navWriting}</a></li>
        <li><a href={graphHref}>{t.navGraph}</a></li>
        <li><a href={gamesHref}>{isEn ? 'Games' : 'Игры'}</a></li>
        <li><a href={aboutHref} class={activeNav === 'about' ? 'active' : ''} aria-current={activeNav === 'about' ? 'page' : undefined}>{t.navAbout}</a></li>
        <li><a href={contactHref} class={activeNav === 'contact' ? 'active' : ''} aria-current={activeNav === 'contact' ? 'page' : undefined}>{t.navContact}</a></li>
      </ul>

      <button id="nav-toggle" class="nav-toggle" type="button" aria-label={isEn ? 'Menu' : 'Меню'} aria-expanded="false" aria-controls="nav-links" data-icon-menu={NAV_MENU} data-icon-close={NAV_CLOSE}>
        <MorphIcon id="nav-icon" icon={NAV_MENU} spring="snappy" reducedMotion="user" size={20} />
      </button>

      <div class="nav-aux">
        {counterpartHref && <LangSwitch locale={lang} counterpartHref={counterpartHref} />}
        <SearchBox lang={lang} />
        <a class="button nav-cta" href={contactHref}>{isEn ? 'Contact' : 'Написать'}</a>
        <a class="nav-telegram" href="https://t.me/lofinibo" target="_blank" rel="noopener noreferrer" aria-label="Telegram" data-analytics="telegram_header">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M21.94 4.6 18.9 19.2c-.23 1.02-.84 1.27-1.7.79l-4.7-3.47-2.27 2.19c-.25.25-.46.46-.94.46l.33-4.79 8.73-7.89c.38-.34-.08-.53-.59-.19L7.6 13.1 2.97 11.65c-1.01-.31-1.03-1.01.21-1.5l17.4-6.7c.84-.31 1.57.19 1.36 1.15z"/>
          </svg>
        </a>
        <button id="theme-toggle" class="theme-toggle" aria-label={`${t.themeLabel}dark${t.themeCycle}`} data-theme-label={t.themeLabel} data-theme-cycle={t.themeCycle} type="button" aria-pressed="true" title={t.themeTitle} data-icon-dark={THEME_MOON} data-icon-light={THEME_SUN} data-icon-cyber={THEME_CYBER}>
          <MorphIcon id="theme-icon" icon={THEME_MOON} spring="snappy" reducedMotion="user" size={18} />
        </button>
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer id="contact">
      <a href="https://github.com/NikitaBoyarkin" data-analytics="github_footer">GitHub</a> ·
      <a href="https://www.linkedin.com/in/nikita-boyarkin" data-analytics="linkedin_footer">LinkedIn</a> ·
      <a href="https://t.me/lofinibo" data-analytics="telegram_footer">Telegram</a> ·
      <a href={withBase('cv/')} data-analytics="cv_footer">{t.footerCv}</a> ·
      <a href={withBase('CV-Nikita-Boyarkin.pdf')} data-analytics="cv_pdf_footer">PDF</a> ·
      <a href={writingHref} data-analytics="writing_footer">{t.footerWriting}</a>
      <p>© {new Date().getFullYear()} Nikita Boyarkin</p>
    </footer>

    <script is:inline>
      // Theme toggle — cycles dark → light → cyberpunk → dark.
      (function () {
        const html = document.documentElement;
        const toggle = document.getElementById('theme-toggle');

        const ICON_PATHS = {
          dark: toggle?.dataset.iconDark,
          light: toggle?.dataset.iconLight,
          cyberpunk: toggle?.dataset.iconCyber,
        };

        const themeColorMeta = document.querySelector('meta[name="theme-color"]');
        const THEME_COLORS = { dark: '#0f2a2b', light: '#f4efca', cyberpunk: '#0a0a12' };
        const ORDER = ['dark', 'light', 'cyberpunk'];

        function applyTheme(theme) {
          html.setAttribute('data-theme', theme);
          const themeIcon = document.getElementById('theme-icon');
          if (themeIcon && ICON_PATHS[theme]) themeIcon.icon = ICON_PATHS[theme];
          if (themeColorMeta) themeColorMeta.setAttribute('content', THEME_COLORS[theme] || THEME_COLORS.dark);
          if (toggle) {
            toggle.setAttribute('aria-pressed', String(theme === 'dark'));
            const label = (toggle.dataset.themeLabel || 'Theme: ') + theme + (toggle.dataset.themeCycle || '. Click to cycle.');
            toggle.setAttribute('aria-label', label);
          }
        }

        function persistTheme(theme) {
          try {
            localStorage.setItem('theme', theme);
          } catch (e) {
            // ignore storage errors
          }
        }

        // Sync icon with already-applied theme
        const current = html.getAttribute('data-theme') || 'dark';
        applyTheme(current);

        if (toggle) {
          toggle.addEventListener('click', () => {
            const cur = html.getAttribute('data-theme') || 'dark';
            const next = ORDER[(ORDER.indexOf(cur) + 1) % ORDER.length];
            applyTheme(next);
            persistTheme(next);
            if (window.posthog) {
              try { window.posthog.capture('theme_change', { theme: next }); } catch (e) { /* ignore */ }
            }
          });
        }

        window
          .matchMedia('(prefers-color-scheme: dark)')
          .addEventListener('change', (e) => {
            try {
              if (localStorage.getItem('theme')) return;
            } catch (e) {
              return;
            }
            applyTheme(e.matches ? 'dark' : 'light');
          });
      })();

      // Reveal on scroll
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('.reveal').forEach((el) => el.classList.add('visible'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      })();

      // Navbar scroll shadow
      (function () {
        const nav = document.querySelector('nav');
        if (!nav) return;
        window.addEventListener('scroll', () => {
          nav.classList.toggle('scrolled', window.scrollY > 20);
        });
      })();

      // Mobile nav toggle — collapses the links behind a hamburger that morphs
      // to ✕ while open (the icon morph is driven by assigning .icon).
      (function () {
        const toggle = document.getElementById('nav-toggle');
        const links = document.getElementById('nav-links');
        if (!toggle || !links) return;
        const icon = document.getElementById('nav-icon');
        const MENU = toggle.dataset.iconMenu;
        const CLOSE = toggle.dataset.iconClose;
        function setOpen(open) {
          links.classList.toggle('open', open);
          toggle.setAttribute('aria-expanded', String(open));
          if (icon && (open ? CLOSE : MENU)) icon.icon = open ? CLOSE : MENU;
        }
        toggle.addEventListener('click', () => setOpen(!links.classList.contains('open')));
        links.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
      })();
    </script>

    <slot name="scripts" />

    <style>
      .nav-aux {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
    </style>
  </body>
</html>

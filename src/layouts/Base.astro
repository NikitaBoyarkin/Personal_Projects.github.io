---
import '../styles/global.css';
import '../styles/blog.css';
import { withBase } from '../lib/path';
import Analytics from '../components/Analytics.astro';
import LangSwitch from '../components/LangSwitch.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  ogType?: 'website' | 'article';
  ogImage?: string;
  canonical?: string;
  activeNav?: 'writing' | 'contact' | 'home' | 'about';
  jsonLd?: Record<string, unknown>;
  lang?: 'ru' | 'en';
  counterpartHref?: string;
}

const {
  title,
  description = 'Nikita Boyarkin — Data Analyst / Product Analyst portfolio. SQL, Python, Visualization, A/B Testing.',
  keywords = [],
  ogType = 'website',
  ogImage = '/images/00_profile.jpg',
  canonical,
  activeNav = 'home',
  jsonLd,
  lang = 'ru',
  counterpartHref,
} = Astro.props;

const siteUrl = (Astro.site?.toString() || 'https://nikitaboyarkin.github.io').replace(/\/$/, '');
const pageUrl = canonical ? `${siteUrl}${canonical}` : Astro.url.toString();
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${withBase(ogImage)}`;
const faviconUrl = withBase('favicon.svg');

// i18n: locale-aware nav hrefs + hreflang alternates.
const isEn = lang === 'en';
const homeHref = isEn ? withBase('en/') : withBase('/');
const aboutHref = isEn ? withBase('en/about/') : withBase('about/');
const projectsHref = isEn ? withBase('en/#projects') : withBase('#projects');
const writingHref = withBase('writing/'); // posts stay RU-only
const contactHref = withBase('contact/'); // contact stays RU-only
const startHref = isEn ? withBase('en/start/') : withBase('start/');
const graphHref = isEn ? withBase('en/graph/') : withBase('graph/');
const counterpartUrl = counterpartHref ? `${siteUrl}${counterpartHref}` : null;
const ruAltUrl = isEn ? counterpartUrl : pageUrl;
const enAltUrl = isEn ? pageUrl : counterpartUrl;
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    {canonical && <link rel="canonical" href={pageUrl} />}

    {counterpartUrl && ruAltUrl && <link rel="alternate" hreflang="ru" href={ruAltUrl} />}
    {counterpartUrl && enAltUrl && <link rel="alternate" hreflang="en" href={enAltUrl} />}
    {counterpartUrl && ruAltUrl && <link rel="alternate" hreflang="x-default" href={ruAltUrl} />}

    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="apple-touch-icon" href={faviconUrl} />
    <link rel="alternate" type="application/rss+xml" title="Nikita Boyarkin — Writing" href={withBase('rss.xml')} />
    <meta id="theme-color" name="theme-color" content="#0f2a2b" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={fullOgImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    {
      jsonLd && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" /></noscript>

    <script is:inline>
      // Prevent theme flash: apply saved or preferred theme before first paint.
      // Three themes: dark (default), light, cyberpunk.
      (function () {
        const html = document.documentElement;
        const themeColorMeta = document.querySelector('meta[name="theme-color"]');
        const THEME_COLORS = { dark: '#0f2a2b', light: '#f4efca', cyberpunk: '#0a0a12' };
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        let theme = prefersDark ? 'dark' : 'light';
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light' || saved === 'cyberpunk') theme = saved;
        } catch (e) {
          // localStorage may be unavailable
        }
        html.setAttribute('data-theme', theme);
        if (themeColorMeta) themeColorMeta.setAttribute('content', THEME_COLORS[theme] || THEME_COLORS.dark);
      })();
    </script>

    <Analytics />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <nav aria-label="Main navigation">
      <a href={homeHref} class="nav-brand" aria-label="Portfolio home">
        <b>Portfolio</b>
      </a>
      <ul class="links">
        <li><a href={startHref}>Start here</a></li>
        <li><a href={projectsHref}>Projects</a></li>
        <li><a href={writingHref} class={activeNav === 'writing' ? 'active' : ''} aria-current={activeNav === 'writing' ? 'page' : undefined}>Writing</a></li>
        <li><a href={graphHref}>Graph</a></li>
        <li><a href={aboutHref} class={activeNav === 'about' ? 'active' : ''} aria-current={activeNav === 'about' ? 'page' : undefined}>About</a></li>
        <li><a href={contactHref} class={activeNav === 'contact' ? 'active' : ''} aria-current={activeNav === 'contact' ? 'page' : undefined}>Contact</a></li>
      </ul>

      <div class="nav-aux">
        {counterpartHref && <LangSwitch locale={lang} counterpartHref={counterpartHref} />}
        <a class="nav-telegram" href="https://t.me/lofinibo" target="_blank" rel="noopener noreferrer" aria-label="Telegram">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M21.94 4.6 18.9 19.2c-.23 1.02-.84 1.27-1.7.79l-4.7-3.47-2.27 2.19c-.25.25-.46.46-.94.46l.33-4.79 8.73-7.89c.38-.34-.08-.53-.59-.19L7.6 13.1 2.97 11.65c-1.01-.31-1.03-1.01.21-1.5l17.4-6.7c.84-.31 1.57.19 1.36 1.15z"/>
          </svg>
        </a>
        <button id="theme-toggle" class="theme-toggle" aria-label="Cycle theme (dark / light / cyberpunk)" type="button" aria-pressed="true" title="Theme: dark / light / cyberpunk">
        <svg class="theme-icon moon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg class="theme-icon sun" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg class="theme-icon cyber" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
        </svg>
      </button>
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer id="contact">
      <a href="https://github.com/NikitaBoyarkin">GitHub</a> ·
      <a href="https://www.linkedin.com/in/nikita-boyarkin">LinkedIn</a> ·
      <a href="https://t.me/lofinibo">Telegram</a> ·
      <a href={withBase('cv/')}>CV</a> ·
      <a href={withBase('writing/')}>Writing</a>
      <p>© {new Date().getFullYear()} Nikita Boyarkin</p>
    </footer>

    <script is:inline>
      // Theme toggle — cycles dark → light → cyberpunk → dark.
      (function () {
        const html = document.documentElement;
        const toggle = document.getElementById('theme-toggle');
        const icons = toggle ? {
          moon: toggle.querySelector('.theme-icon.moon'),
          sun: toggle.querySelector('.theme-icon.sun'),
          cyber: toggle.querySelector('.theme-icon.cyber'),
        } : null;

        const themeColorMeta = document.querySelector('meta[name="theme-color"]');
        const THEME_COLORS = { dark: '#0f2a2b', light: '#f4efca', cyberpunk: '#0a0a12' };
        const ORDER = ['dark', 'light', 'cyberpunk'];

        function applyTheme(theme) {
          html.setAttribute('data-theme', theme);
          if (icons) {
            icons.moon.style.display = theme === 'dark' ? 'block' : 'none';
            icons.sun.style.display = theme === 'light' ? 'block' : 'none';
            icons.cyber.style.display = theme === 'cyberpunk' ? 'block' : 'none';
          }
          if (themeColorMeta) themeColorMeta.setAttribute('content', THEME_COLORS[theme] || THEME_COLORS.dark);
          if (toggle) {
            toggle.setAttribute('aria-pressed', String(theme === 'dark'));
            toggle.setAttribute('aria-label', `Theme: ${theme}. Click to cycle.`);
          }
        }

        function persistTheme(theme) {
          try {
            localStorage.setItem('theme', theme);
          } catch (e) {
            // ignore storage errors
          }
        }

        // Sync icon with already-applied theme
        const current = html.getAttribute('data-theme') || 'dark';
        applyTheme(current);

        if (toggle) {
          toggle.addEventListener('click', () => {
            const cur = html.getAttribute('data-theme') || 'dark';
            const next = ORDER[(ORDER.indexOf(cur) + 1) % ORDER.length];
            applyTheme(next);
            persistTheme(next);
          });
        }

        window
          .matchMedia('(prefers-color-scheme: dark)')
          .addEventListener('change', (e) => {
            try {
              if (localStorage.getItem('theme')) return;
            } catch (e) {
              return;
            }
            applyTheme(e.matches ? 'dark' : 'light');
          });
      })();

      // Reveal on scroll
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('.reveal').forEach((el) => el.classList.add('visible'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      })();

      // Navbar scroll shadow
      (function () {
        const nav = document.querySelector('nav');
        if (!nav) return;
        window.addEventListener('scroll', () => {
          nav.classList.toggle('scrolled', window.scrollY > 20);
        });
      })();
    </script>

    <slot name="scripts" />

    <style>
      .nav-aux {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
    </style>
  </body>
</html>

---
import { withBase } from '../lib/path';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

// Source of truth: rendercv — /Users/nikitaboarkin/Desktop/00 ide/00 portfolio/cv
// (Boyarkin_Nikita_Product_Analyst_CV.yaml). Keep in sync with that file.
const profile = [
  'Аналитик данных с 4+ годами опыта в аналитике и исследованиях. Специализируюсь на A/B-тестах, сегментации клиентов и автоматизации отчетности. Грейд: Middle.',
  'Стек: SQL, Python, DuckDB, PostgreSQL, ClickHouse, Tableau, Superset, Docker, Airflow.',
];

const projects = [
  {
    title: 'Volta Neobank — Product Analytics',
    period: 'Apr 2025 – present',
    summary:
      'Сквозной кейс аналитики необанка: воронка, A/B-тест, удержание, сегментация (синтетические данные).',
    highlights: [
      'Провёл A/B-тест KYC для нового процесса верификации → увеличил конверсию на 6.24 п.п., что обеспечило дополнительно €716K дохода в год.',
      'Разработал стратегию удержания → увеличил retention на 9.2 п.п. к 3-му месяцу, что принесло дополнительно €227K LTV.',
      'Использовал KMeans для сегментации пользователей на 4 группы → 12% пользователей генерируют 41% выручки, что дало возможность оптимизировать маркетинговые усилия; предложенный сценарий миграции может увеличить доход на €310K/год.',
    ],
    github: 'https://github.com/NikitaBoyarkin/volta-banking',
  },
  {
    title: 'RFM Analysis of Bank Clients',
    period: 'Jan 2025 – Mar 2025',
    summary:
      'Провёл RFM-сегментацию клиентов → выделил 20% high-value клиентов, генерирующих 60% выручки, что позволило оптимизировать стратегии удержания.',
    highlights: [
      'Перевёл фокус с массовых рассылок на сегментированные сценарии удержания и реактивации.',
    ],
    github: 'https://github.com/NikitaBoyarkin/rfm-analysis-of-bank-clients',
  },
  {
    title: 'SQL Analytics Case Study',
    period: 'Feb 2025',
    summary:
      'Создал 10 SQL-кейсов для анализа воронки, удержания, DAU/MAU, LTV и атрибуции выручки → улучшил качество данных для отчетности на 30%.',
    highlights: [
      'Запуск без сервера (DuckDB); каждый кейс с автоматической проверкой результата.',
    ],
    github: 'https://github.com/NikitaBoyarkin/sql-analytics-case-study',
  },
  {
    title: 'Reporting Automation Telegram Bot',
    period: 'Mar 2025',
    summary:
      'Разработал Telegram-бота для автоматизации еженедельного отчета → сократил время на сбор данных с 2 часов до 5 минут, что увеличило эффективность команды.',
    highlights: [],
    github: 'https://github.com/NikitaBoyarkin/telegram_bot',
  },
];

const skillGroups = [
  { label: 'Data', details: 'Python, SQL, Pandas, NumPy, DuckDB, PostgreSQL, ClickHouse' },
  { label: 'Statistics', details: 'SciPy, Statsmodels, scikit-learn; A/B testing (CUPED, AA-test, Bonferroni)' },
  { label: 'Visualization', details: 'Tableau, Superset, Matplotlib, Seaborn' },
  { label: 'Infrastructure', details: 'Docker, Airflow, Git, cron' },
  { label: 'Methods', details: 'Funnel, Cohort & Retention, RFM, LTV, SQL window functions' },
  { label: 'AI tooling', details: 'GenAI, LLM APIs' },
];

// Absolute URL for the "Download CV" funnel and printed copy.
const siteUrl = 'https://nikitaboyarkin.github.io/Personal_Projects.github.io/';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ru" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Boyarkin Nikita — CV</title>
    <meta name="description" content="CV of Boyarkin Nikita — Data / Product Analyst." />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
    />
  </head>
  <body>
    <div class="cv-toolbar no-print">
      <a href={withBase('/')} class="cv-back">← Back to portfolio</a>
      <span class="cv-toolbar-actions">
        <a href={withBase('CV-Nikita-Boyarkin.pdf')} class="cv-print" data-analytics="cv_download_pdf">Download PDF</a>
        <a href="https://github.com/NikitaBoyarkin/cv" class="cv-source-link" target="_blank" rel="noopener noreferrer" data-analytics="cv_source_github">Source (GitHub)</a>
        <button type="button" class="cv-print" onclick="window.print()">Print</button>
      </span>
    </div>

    <main class="cv">
      <header class="cv-header">
        <h1>Boyarkin Nikita</h1>
        <p class="cv-role">Data / Product Analyst</p>
        <p class="cv-contact">
          <a href="https://t.me/lofinibo">Telegram · @lofinibo</a>
          <span aria-hidden="true">·</span>
          <a href="https://github.com/NikitaBoyarkin">GitHub</a>
          <span aria-hidden="true">·</span>
          <a href="https://www.linkedin.com/in/nikita-boyarkin">LinkedIn</a>
          <span aria-hidden="true">·</span>
          <a href={siteUrl}>{siteUrl.replace(/^https?:\/\//, '')}</a>
        </p>
        <p class="cv-open">Открыт к ролям Data / Product Analyst.</p>
      </header>

      <section class="cv-section">
        <h2>Summary</h2>
        <ul class="cv-profile">
          {profile.map((b) => <li>{b}</li>)}
        </ul>
      </section>

      <section class="cv-section">
        <h2>Skills</h2>
        <ul class="cv-skill-groups">
          {skillGroups.map((g) => (
            <li><strong>{g.label}:</strong> {g.details}</li>
          ))}
        </ul>
      </section>

      <section class="cv-section">
        <h2>Projects</h2>
        {projects.map((p) => (
          <article class="cv-project">
            <h3>
              {p.title}
              <span class="cv-period">{p.period}</span>
              {p.github && (
                <a class="cv-source" href={p.github} target="_blank" rel="noopener noreferrer">source →</a>
              )}
            </h3>
            <p class="cv-stack">{p.summary}</p>
            {p.highlights.length > 0 && (
              <ul class="cv-impact">
                {p.highlights.map((h) => <li>{h}</li>)}
              </ul>
            )}
          </article>
        ))}
      </section>

      <section class="cv-section">
        <h2>Статьи</h2>
        <ul class="cv-writing">
          {posts.map((post) => (
            <li>
              <span class="cv-writing-date">{post.data.date.toISOString().slice(0, 7)}</span>
              <span class="cv-writing-title">{post.data.title}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="cv-section">
        <h2>Образование</h2>
        <ul class="cv-edu">
          <li>
            <span class="cv-edu-degree">PhD, Психология труда</span>
            <span class="cv-edu-school">UMC, Москва</span>
            <span class="cv-edu-period">Sept 2022 – May 2025</span>
          </li>
          <li>
            <span class="cv-edu-degree">MSc, Психология труда</span>
            <span class="cv-edu-school">UMC, Москва</span>
            <span class="cv-edu-period">Sept 2020 – May 2022</span>
          </li>
          <li>
            <span class="cv-edu-degree">BSc, Бизнес информатика</span>
            <span class="cv-edu-school">UMC, Москва</span>
            <span class="cv-edu-period">Sept 2016 – May 2020</span>
          </li>
        </ul>
      </section>
    </main>

    <p class="cv-foot no-print">Совет: используйте «Печать / Сохранить как PDF» для одностраничной копии. © {year} Boyarkin Nikita.</p>

    <style>
      :root {
        --ink: #18181b;
        --muted: #52525b;
        --accent: #c63d1f;
        --line: #d4d4d8;
        --bg: #ffffff;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: #f4f4f5;
        color: var(--ink);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.5;
        font-size: 14px;
        -webkit-font-smoothing: antialiased;
      }
      .cv-toolbar {
        max-width: 820px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .cv-toolbar-actions {
        display: flex;
        gap: 0.5rem;
        align-items: center;
      }
      .cv-back { color: var(--accent); text-decoration: none; font-weight: 500; }
      .cv-print {
        background: var(--accent);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
      }
      .cv-source-link {
        color: var(--accent);
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        padding: 0.5rem 0.25rem;
      }
      .cv-source-link:hover { text-decoration: underline; }
      .cv {
        max-width: 820px;
        margin: 0 auto;
        background: var(--bg);
        padding: 2.5rem 3rem 3rem;
        box-shadow: 0 1px 12px rgba(0, 0, 0, 0.06);
      }
      .cv-header { margin-bottom: 1.5rem; border-bottom: 2px solid var(--ink); padding-bottom: 1rem; }
      .cv-header h1 { margin: 0; font-size: 1.9rem; letter-spacing: -0.02em; }
      .cv-role { margin: 0.15rem 0 0.6rem; color: var(--accent); font-weight: 600; font-size: 1.05rem; }
      .cv-contact { margin: 0 0 0.4rem; font-size: 0.82rem; color: var(--muted); display: flex; flex-wrap: wrap; gap: 0.4rem; }
      .cv-contact a { color: var(--muted); text-decoration: none; }
      .cv-contact a:hover { color: var(--accent); text-decoration: underline; }
      .cv-open { margin: 0; font-size: 0.82rem; font-weight: 500; color: var(--ink); }
      .cv-section { margin-top: 1.3rem; }
      .cv-section h2 { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); border-bottom: 1px solid var(--line); padding-bottom: 0.25rem; margin: 0 0 0.6rem; }
      .cv-section p { margin: 0 0 0.4rem; color: var(--ink); }
      .cv-profile { list-style: none; padding: 0; margin: 0; }
      .cv-profile li { padding: 0.2rem 0; font-size: 0.9rem; color: var(--ink); }
      .cv-skill-groups { list-style: none; padding: 0; margin: 0; }
      .cv-skill-groups li { padding: 0.2rem 0; font-size: 0.88rem; color: var(--ink); }
      .cv-skill-groups strong { color: var(--ink); }
      .cv-project { margin-bottom: 0.7rem; }
      .cv-project h3 { margin: 0 0 0.1rem; font-size: 1rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem; }
      .cv-period { font-size: 0.75rem; font-weight: 400; color: var(--muted); font-variant-numeric: tabular-nums; }
      .cv-source { margin-left: 0.2rem; font-size: 0.75rem; font-weight: 400; color: var(--accent); text-decoration: none; }
      .cv-source:hover { text-decoration: underline; }
      .cv-stack { margin: 0 0 0.3rem; font-size: 0.8rem; color: var(--muted); font-style: italic; }
      .cv-impact { margin: 0; padding-left: 1.1rem; color: var(--ink); font-size: 0.85rem; }
      .cv-impact li { margin-bottom: 0.15rem; }
      .cv-writing { list-style: none; padding: 0; margin: 0; }
      .cv-writing li { display: flex; gap: 0.8rem; padding: 0.2rem 0; font-size: 0.88rem; border-bottom: 1px dotted var(--line); }
      .cv-writing-date { color: var(--muted); font-variant-numeric: tabular-nums; flex: 0 0 5rem; }
      .cv-writing-title { color: var(--ink); }
      .cv-edu { list-style: none; padding: 0; margin: 0; }
      .cv-edu li { display: flex; flex-wrap: wrap; gap: 0.4rem 0.8rem; padding: 0.2rem 0; font-size: 0.88rem; border-bottom: 1px dotted var(--line); }
      .cv-edu-degree { color: var(--ink); font-weight: 500; }
      .cv-edu-school { color: var(--muted); }
      .cv-edu-period { color: var(--muted); font-variant-numeric: tabular-nums; margin-left: auto; }
      .cv-placeholder { color: var(--muted); font-style: italic; font-size: 0.85rem; }
      .cv-foot { text-align: center; color: var(--muted); font-size: 0.78rem; margin: 1rem 0 2rem; }

      @media print {
        @page { size: A4; margin: 14mm 12mm; }
        body { background: white; font-size: 11.5pt; }
        .no-print { display: none !important; }
        .cv { max-width: none; box-shadow: none; padding: 0; }
        .cv-header { page-break-after: avoid; }
        .cv-section { page-break-inside: avoid; }
        a { color: var(--ink) !important; text-decoration: none !important; }
        .cv-role, .cv-section h2 { color: var(--ink) !important; }
      }
    </style>
  </body>
</html>
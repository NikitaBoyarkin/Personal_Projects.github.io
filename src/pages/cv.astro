---
import { withBase } from '../lib/path';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
const posts = (await getCollection('posts', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const skills = [
  'SQL',
  'Python',
  'Pandas',
  'A/B Testing',
  'SciPy / Statsmodels',
  'Cohort & Retention',
  'RFM Segmentation',
  'Tableau',
  'Matplotlib / Seaborn',
  'Dashboard Design',
];

// Absolute URL for the "Download CV" funnel and printed copy.
const siteUrl = 'https://nikitaboyarkin.github.io/Personal_Projects.github.io/';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nikita Boyarkin — CV</title>
    <meta name="description" content="CV of Nikita Boyarkin — Data Analyst / Product Analyst." />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="cv-toolbar no-print">
      <a href={withBase('/')} class="cv-back">← Back to portfolio</a>
      <button type="button" class="cv-print" onclick="window.print()">Print / Save as PDF</button>
    </div>

    <main class="cv">
      <header class="cv-header">
        <h1>Nikita Boyarkin</h1>
        <p class="cv-role">Data Analyst / Product Analyst</p>
        <p class="cv-contact">
          <a href="https://t.me/lofinibo">Telegram · @lofinibo</a>
          <span aria-hidden="true">·</span>
          <a href="https://github.com/NikitaBoyarkin">GitHub</a>
          <span aria-hidden="true">·</span>
          <a href="https://www.linkedin.com/in/nikita-boyarkin">LinkedIn</a>
          <span aria-hidden="true">·</span>
          <a href={siteUrl}>{siteUrl.replace(/^https?:\/\//, '')}</a>
        </p>
        <p class="cv-open">Open to Data / Product Analyst roles — remote or EU.</p>
      </header>

      <section class="cv-section">
        <h2>Profile</h2>
        <p>
          Data Analyst with 3+ years of experience turning complex data into actionable business
          insights. I work at the intersection of product, data, and experimentation — customer
          analytics, A/B testing, dashboard design, and data pipelines that help teams make faster
          decisions.
        </p>
      </section>

      <section class="cv-section">
        <h2>Skills</h2>
        <ul class="cv-skills">
          {skills.map((s) => <li>{s}</li>)}
        </ul>
      </section>

      <section class="cv-section">
        <h2>Selected Projects</h2>
        {projects.map((p) => (
          <article class="cv-project">
            <h3>
              {p.data.title}
              {p.data.github && (
                <a class="cv-source" href={p.data.github} target="_blank" rel="noopener noreferrer">source →</a>
              )}
            </h3>
            <p class="cv-stack">{p.data.tools.join(' · ')}</p>
            {p.data.impact.length > 0 && (
              <ul class="cv-impact">
                {p.data.impact.map((i) => <li>{i}</li>)}
              </ul>
            )}
          </article>
        ))}
      </section>

      <section class="cv-section">
        <h2>Writing</h2>
        <ul class="cv-writing">
          {posts.map((post) => (
            <li>
              <span class="cv-writing-date">{post.data.date.toISOString().slice(0, 7)}</span>
              <span class="cv-writing-title">{post.data.title}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- TODO: fill in real work history before sending to recruiters. -->
      <section class="cv-section">
        <h2>Experience</h2>
        <p class="cv-placeholder">
          Add roles here: title, company, period, and 2–3 bullet points quantifying impact
          (metrics moved, experiments run, dashboards shipped).
        </p>
      </section>

      <!-- TODO: fill in education. -->
      <section class="cv-section">
        <h2>Education</h2>
        <p class="cv-placeholder">Add degree, institution, and year.</p>
      </section>
    </main>

    <p class="cv-foot no-print">Tip: use “Print / Save as PDF” for a one-page copy. © {year} Nikita Boyarkin.</p>

    <style>
      :root {
        --ink: #18181b;
        --muted: #52525b;
        --accent: #2563eb;
        --line: #d4d4d8;
        --bg: #ffffff;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: #f4f4f5;
        color: var(--ink);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.5;
        font-size: 14px;
        -webkit-font-smoothing: antialiased;
      }
      .cv-toolbar {
        max-width: 820px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .cv-back { color: var(--accent); text-decoration: none; font-weight: 500; }
      .cv-print {
        background: var(--accent);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
      }
      .cv {
        max-width: 820px;
        margin: 0 auto;
        background: var(--bg);
        padding: 2.5rem 3rem 3rem;
        box-shadow: 0 1px 12px rgba(0, 0, 0, 0.06);
      }
      .cv-header { margin-bottom: 1.5rem; border-bottom: 2px solid var(--ink); padding-bottom: 1rem; }
      .cv-header h1 { margin: 0; font-size: 1.9rem; letter-spacing: -0.02em; }
      .cv-role { margin: 0.15rem 0 0.6rem; color: var(--accent); font-weight: 600; font-size: 1.05rem; }
      .cv-contact { margin: 0 0 0.4rem; font-size: 0.82rem; color: var(--muted); display: flex; flex-wrap: wrap; gap: 0.4rem; }
      .cv-contact a { color: var(--muted); text-decoration: none; }
      .cv-contact a:hover { color: var(--accent); text-decoration: underline; }
      .cv-open { margin: 0; font-size: 0.82rem; font-weight: 500; color: var(--ink); }
      .cv-section { margin-top: 1.3rem; }
      .cv-section h2 { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); border-bottom: 1px solid var(--line); padding-bottom: 0.25rem; margin: 0 0 0.6rem; }
      .cv-section p { margin: 0 0 0.4rem; color: var(--ink); }
      .cv-skills { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
      .cv-skills li { background: #f4f4f5; border: 1px solid var(--line); border-radius: 9999px; padding: 0.2rem 0.6rem; font-size: 0.78rem; color: var(--muted); }
      .cv-project { margin-bottom: 0.7rem; }
      .cv-project h3 { margin: 0 0 0.1rem; font-size: 1rem; }
      .cv-source { margin-left: 0.5rem; font-size: 0.75rem; font-weight: 400; color: var(--accent); text-decoration: none; }
      .cv-source:hover { text-decoration: underline; }
      .cv-stack { margin: 0 0 0.3rem; font-size: 0.8rem; color: var(--muted); font-style: italic; }
      .cv-impact { margin: 0; padding-left: 1.1rem; color: var(--ink); font-size: 0.85rem; }
      .cv-impact li { margin-bottom: 0.15rem; }
      .cv-writing { list-style: none; padding: 0; margin: 0; }
      .cv-writing li { display: flex; gap: 0.8rem; padding: 0.2rem 0; font-size: 0.88rem; border-bottom: 1px dotted var(--line); }
      .cv-writing-date { color: var(--muted); font-variant-numeric: tabular-nums; flex: 0 0 5rem; }
      .cv-writing-title { color: var(--ink); }
      .cv-placeholder { color: var(--muted); font-style: italic; font-size: 0.85rem; }
      .cv-foot { text-align: center; color: var(--muted); font-size: 0.78rem; margin: 1rem 0 2rem; }

      @media print {
        @page { size: A4; margin: 14mm 12mm; }
        body { background: white; font-size: 11.5pt; }
        .no-print { display: none !important; }
        .cv { max-width: none; box-shadow: none; padding: 0; }
        .cv-header { page-break-after: avoid; }
        .cv-section { page-break-inside: avoid; }
        a { color: var(--ink) !important; text-decoration: none !important; }
        .cv-role, .cv-section h2 { color: var(--ink) !important; }
      }
    </style>
  </body>
</html>
---
import Base from '../layouts/Base.astro';
import BlogCard from '../components/BlogCard.astro';
import BlogFilter from '../components/BlogFilter.astro';
import { getCollection } from 'astro:content';
import { estimateReadTime } from '../lib/date';
import { withBase } from '../lib/path';

const posts = (await getCollection('posts', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  title="Статьи | Nikita Boyarkin"
  description="Статьи о продуктовой аналитике, A/B-тестировании и работе с данными от Никиты Бояркина."
  activeNav="writing"
  lang="ru"
>
  <h1 class="page-title reveal">Статьи</h1>

  <p class="reveal" style="color: var(--text-muted); margin-bottom: var(--space-4); max-width: 60ch;">
    Всё вместе выше. Можно читать по типу:
    <a href={withBase('guides/')}>гайды</a> (evergreen-методология) ·
    <a href={withBase('notes/')}>заметки</a> (decision-логи).
  </p>

  <BlogFilter />

  <div class="blog-list reveal reveal-delay-2">
    {
      posts.map((post) => (
        <BlogCard
          slug={post.id.replace(/\.md$/, '')}
          title={post.data.title}
          category={post.data.category}
          date={post.data.date}
          excerpt={post.data.excerpt}
          readTime={estimateReadTime(post.body)}
        />
      ))
    }
  </div>
</Base>

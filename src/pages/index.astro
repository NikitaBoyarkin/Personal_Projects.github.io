---
import Base from '../layouts/Base.astro';
import IntroShader from '../components/IntroShader.astro';
import CapabilitiesGrid from '../components/CapabilitiesGrid.astro';
import HeroMetrics from '../components/HeroMetrics.astro';
import HeroCta from '../components/HeroCta.astro';
import CareerSnapshot from '../components/CareerSnapshot.astro';
import Testimonials from '../components/Testimonials.astro';
import ReadingBlock from '../components/ReadingBlock.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/path';

const allProjects = await getCollection('projects', (p) => !p.data.draft);
const featuredProject =
  allProjects.find((p) => p.id === 'posthog') || allProjects[0];

const siteUrl = 'https://nikitaboyarkin.github.io/Personal_Projects.github.io/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'Nikita Boyarkin',
      url: siteUrl,
      jobTitle: 'Data Analyst / Product Analyst',
      sameAs: [
        'https://github.com/NikitaBoyarkin',
        'https://www.linkedin.com/in/nikita-boyarkin',
      ],
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Data Analyst / Product Analyst',
      },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'UMC',
      },
      knowsAbout: [
        'A/B testing',
        'Product analytics',
        'Retention analysis',
        'Customer segmentation (RFM)',
        'SQL',
        'Python',
        'Data visualization',
      ],
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', '.tagline'],
      },
    },
    {
      '@type': 'ItemList',
      name: 'Projects',
      numberOfItems: allProjects.length,
      itemListElement: allProjects.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.data.title,
        url: `${siteUrl}${withBase(`projects/${p.id.replace(/\.md$/, '')}/`)}`,
      })),
    },
  ],
};
---

<Base
  title="Nikita Boyarkin | Аналитик данных / продуктовый аналитик"
  description="Портфолио Никиты Бояркина — Data Analyst / Product Analyst. Проекты по SQL, Python, A/B-тестированию, визуализации и клиентской аналитике."
  ogImage="/images/og/portfolio-banner.png"
  canonical={withBase('/')}
  activeNav="home"
  lang="ru"
  counterpartHref={withBase('en/')}
  jsonLd={jsonLd}
>
  <!-- HERO — editorial split: identity left, dataviz panel right -->
  <section id="intro">
    <div class="intro-container hero-editorial">
      <div class="hero-body">
        <img
          class="hero-avatar"
          src={withBase('images/00_profile.webp')}
          alt="Nikita Boyarkin"
          width="72"
          height="72"
          loading="eager"
          fetchpriority="high"
        />
        <h1 class="hero-name">Nikita Boyarkin</h1>
        <p class="hero-role">Аналитик данных · SQL · Python · A/B-эксперименты</p>
        <p class="hero-pitch">
          Превращаю сырые данные в измеримые продуктовые решения: от гипотезы до метрики и роста.
        </p>

        <HeroMetrics lang="ru" />

        <p class="cta-row">
          <HeroCta lang="ru" />
          <a class="button button-secondary" href={withBase('projects/')} data-analytics="hero_projects">Проекты</a>
          <a class="button button-secondary" href={withBase('cv/')} target="_blank" rel="noopener" data-analytics="hero_cv">CV</a>
        </p>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <IntroShader />
        <dl class="hero-viz-cards">
          <div class="hero-viz-card">
            <dt>KYC-конверсия</dt>
            <dd>+6.24 pp</dd>
          </div>
          <div class="hero-viz-card">
            <dt>Годовой эффект фикса</dt>
            <dd>€716K</dd>
          </div>
          <div class="hero-viz-card">
            <dt>Проектов в портфолио</dt>
            <dd>14</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- EDITORIAL TOP + BENTO BOTTOM -->
  <div class="home-layout">
    <!-- Featured project -->
    <section class="editorial-section" id="featured-project" aria-labelledby="featured-heading">
      <h2 id="featured-heading">Избранный проект</h2>
      <p class="section-lead">
        Один разбор, который показывает полный цикл: метрика → гипотеза → эксперимент → решение.
      </p>

      <article class="featured-card">
        <img
          class="featured-card-image"
          src={withBase(featuredProject.data.hero)}
          alt=""
          loading="lazy"
        />
        <div class="featured-card-body">
          <h3 class="featured-card-title">{featuredProject.data.title}</h3>
          <p class="featured-card-description">{featuredProject.data.description}</p>
          <div class="bento-chip-list">
            {featuredProject.data.tools?.slice(0, 5).map((tool: string) => (
              <span class="bento-chip">{tool}</span>
            ))}
          </div>
          <a
            class="featured-card-link"
            href={withBase(`projects/${featuredProject.id.replace(/\.md$/, '')}/`)}
            data-analytics="featured_project"
          >
            Разбор проекта →
          </a>
        </div>
      </article>
    </section>

    <!-- Capabilities -->
    <section class="editorial-section" id="capabilities" aria-labelledby="capabilities-heading">
      <h2 id="capabilities-heading">Что я делаю</h2>
      <p class="section-lead">
        Шесть компетенций — у каждой конкретный результат и измеримый эффект.
      </p>
      <CapabilitiesGrid lang="ru" />
    </section>

    <!-- Bento bottom -->
    <div class="bento-grid">
      <!-- Career snapshot -->
      <div class="bento-cell bento-cell-wide" tabindex="-1">
        <CareerSnapshot lang="ru" />
      </div>

      <!-- Knowledge graph -->
      <div class="bento-cell" tabindex="-1">
        <h3 class="bento-cell-title">Граф знаний</h3>
        <p class="bento-cell-heading">Исследуй связи</p>
        <p class="bento-cell-text">
          Все заметки, проекты и темы связаны в интерактивный граф. Найди путь от SQL до A/B-теста.
        </p>
        <a class="bento-cell-link" href={withBase('graph/')} data-analytics="bento_graph">
          Открыть граф →
        </a>
      </div>

      <!-- Reading / library -->
      <div class="bento-cell" tabindex="-1">
        <ReadingBlock lang="ru" />
      </div>

      <!-- Notes -->
      <div class="bento-cell" tabindex="-1">
        <h3 class="bento-cell-title">Заметки</h3>
        <p class="bento-cell-heading">Продуктовая аналитика в заметках</p>
        <p class="bento-cell-text">
          Разборы методологии, чек-листы и шаблоны для повседневной работы аналитика.
        </p>
        <a class="bento-cell-link" href={withBase('writing/')} data-analytics="bento_notes">
          Читать заметки →
        </a>
      </div>

      <!-- Games / arcade -->
      <div class="bento-cell" tabindex="-1">
        <h3 class="bento-cell-title">Аркада</h3>
        <p class="bento-cell-heading">Игры об аналитике</p>
        <p class="bento-cell-text">
          Мини-игры в браузере: A/B Test, Funnel Drop, Snake, 2048, Pong. Работают на телефоне.
        </p>
        <a class="bento-cell-link" href={withBase('games/')} data-analytics="bento_arcade">
          Играть →
        </a>
      </div>

      <!-- Testimonials -->
      <div class="bento-cell bento-cell-wide" tabindex="-1">
        <Testimonials lang="ru" />
      </div>
    </div>
  </div>
</Base>

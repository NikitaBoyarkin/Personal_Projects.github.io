---
import Base from '../layouts/Base.astro';
import HomeBoard from '../components/HomeBoard.astro';
import IntroShader from '../components/IntroShader.astro';
import Manifesto from '../components/Manifesto.astro';
import TopicMap from '../components/TopicMap.astro';
import ProjectTimeline from '../components/ProjectTimeline.astro';
import CollaborationFormats from '../components/CollaborationFormats.astro';
import MaterialStrip from '../components/MaterialStrip.astro';
import AskMe from '../components/AskMe.astro';
import CapabilitiesGrid from '../components/CapabilitiesGrid.astro';
import HeroMetrics from '../components/HeroMetrics.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/path';
import ArrowMorph from '../components/ArrowMorph.astro';
import AudienceBar from '../components/AudienceBar.astro';
import CareerSnapshot from '../components/CareerSnapshot.astro';
import Testimonials from '../components/Testimonials.astro';
import ReadingBlock from '../components/ReadingBlock.astro';

const allProjects = await getCollection('projects', (p) => !p.data.draft);

const siteUrl = 'https://nikitaboyarkin.github.io/Personal_Projects.github.io/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'Nikita Boyarkin',
      url: siteUrl,
      jobTitle: 'Data Analyst / Product Analyst',
      sameAs: [
        'https://github.com/NikitaBoyarkin',
        'https://www.linkedin.com/in/nikita-boyarkin',
      ],
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Data Analyst / Product Analyst',
      },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'UMC',
      },
      knowsAbout: [
        'A/B testing',
        'Product analytics',
        'Retention analysis',
        'Customer segmentation (RFM)',
        'SQL',
        'Python',
        'Data visualization',
      ],
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', '.tagline'],
      },
    },
    {
      '@type': 'ItemList',
      name: 'Projects',
      numberOfItems: allProjects.length,
      itemListElement: allProjects.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.data.title,
        url: `${siteUrl}${withBase(`projects/${p.id.replace(/\.md$/, '')}/`)}`,
      })),
    },
  ],
};
---

<Base
  title="Nikita Boyarkin | Аналитик данных / продуктовый аналитик"
  description="Портфолио Никиты Бояркина — Data Analyst / Product Analyst. Проекты по SQL, Python, A/B-тестированию, визуализации и клиентской аналитике."
  ogImage="/images/og/portfolio-banner.png"
  canonical={withBase('/')}
  activeNav="home"
  lang="ru"
  counterpartHref={withBase('en/')}
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section id="intro">
    <IntroShader />
    <div class="intro-container intro-container-slim">
      <div class="intro-content">
        <h1>Nikita Boyarkin</h1>
        <p class="tagline">Данные → решения. От гипотезы до ship-gate.</p>
        <div class="subtitle">Аналитик данных · SQL · Python · A/B-эксперименты</div>

        <HeroMetrics lang="ru" />

        <p class="cta-row">
          <a class="button" href={withBase('start/')}>С чего начать</a>
          <a class="button button-secondary" href={withBase('cv/')} target="_blank" rel="noopener">CV</a>
          <a class="button button-secondary" href={withBase('CV-Nikita-Boyarkin.pdf')} data-analytics="cv_download_pdf" target="_blank" rel="noopener">Скачать PDF</a>
          <span class="cta-links">
            <a href="https://github.com/NikitaBoyarkin" data-analytics="github_hero">GitHub</a> ·
            <a href="https://www.linkedin.com/in/nikita-boyarkin" data-analytics="linkedin_hero">LinkedIn</a> ·
            <a href={withBase('graph/')}>Граф</a>
          </span>
        </p>
      </div>
    </div>
  </section>

  <!-- Кто смотрит: переключатель аудитории переупорядочивает стек ниже -->
  <AudienceBar lang="ru" />

  <div class="home-stack">
    <div class="home-board" data-order-analyst="0" data-order-learner="0">
      <!-- KANBAN BOARD: Профиль | Проекты | Сейчас в работе -->
      <HomeBoard lang="ru" />
    </div>

    <div class="home-career" data-order-analyst="6" data-order-learner="7">
      <!-- Опыт + Образование: грейд и измеренные результаты -->
      <CareerSnapshot lang="ru" />
    </div>

    <div class="home-askme" data-order-analyst="7" data-order-learner="5">
      <!-- AI-ассистент «Спроси меня» (static, client-side) -->
      <AskMe lang="ru" />
    </div>

    <div class="home-caps" data-order-analyst="1" data-order-learner="3">
      <!-- Capabilities grid: deliverables + measured results -->
      <CapabilitiesGrid lang="ru" />
    </div>

    <div class="home-manifesto" data-order-analyst="6" data-order-learner="7">
      <Manifesto />
    </div>

    <div class="home-topics" data-order-analyst="4" data-order-learner="2">
      <TopicMap />
    </div>

    <div class="home-timeline" data-order-analyst="2" data-order-learner="4">
      <ProjectTimeline />
    </div>

    <div class="home-arcade" data-order-analyst="8" data-order-learner="8">
      <!-- GAMES ARCADE -->
      <section id="arcade" class="reveal" aria-label="Игры">
        <h2>🎮 Аркада</h2>
        <p>
          Мини-игры в браузере — и про аналитику тоже: A/B Test (догони p &lt; 0.05), Funnel Drop
          (лови пользователей в воронке), и классические Snake / 2048 / Pong. Работают на телефоне:
          свайпы, drag, тап.
        </p>
        <p>
          <a class="button" href={withBase('games/')}>Играть <ArrowMorph /></a>
        </p>
      </section>
    </div>

    <div class="home-collab" data-order-analyst="5" data-order-learner="6">
      <CollaborationFormats />
    </div>

    <!-- Testimonials: пуст пока не собраны реальные отзывы (рендер без данных = ничего) -->
    <div class="home-testimonials" data-order-analyst="7" data-order-learner="9">
      <Testimonials lang="ru" />
    </div>

    <!-- Библиотека / сейчас читаю -->
    <div class="home-library" data-order-analyst="8" data-order-learner="4">
      <ReadingBlock lang="ru" />
    </div>

    <div class="home-strip" data-order-analyst="3" data-order-learner="1">
      <MaterialStrip />
    </div>
  </div>
</Base>
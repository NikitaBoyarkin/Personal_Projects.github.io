---
import Base from '../layouts/Base.astro';
import HomeBoard from '../components/HomeBoard.astro';
import IntroShader from '../components/IntroShader.astro';
import Manifesto from '../components/Manifesto.astro';
import TopicMap from '../components/TopicMap.astro';
import ProjectTimeline from '../components/ProjectTimeline.astro';
import CollaborationFormats from '../components/CollaborationFormats.astro';
import MaterialStrip from '../components/MaterialStrip.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/path';
import ArrowMorph from '../components/ArrowMorph.astro';

const allProjects = await getCollection('projects', (p) => !p.data.draft);

const siteUrl = 'https://nikitaboyarkin.github.io/Personal_Projects.github.io/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'Nikita Boyarkin',
      url: siteUrl,
      jobTitle: 'Data Analyst / Product Analyst',
      sameAs: [
        'https://github.com/NikitaBoyarkin',
        'https://www.linkedin.com/in/nikita-boyarkin',
      ],
    },
    {
      '@type': 'ItemList',
      name: 'Projects',
      numberOfItems: allProjects.length,
      itemListElement: allProjects.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.data.title,
        url: `${siteUrl}${withBase(`projects/${p.id.replace(/\.md$/, '')}/`)}`,
      })),
    },
  ],
};
---

<Base
  title="Nikita Boyarkin | Аналитик данных / продуктовый аналитик"
  description="Портфолио Никиты Бояркина — Data Analyst / Product Analyst. Проекты по SQL, Python, A/B-тестированию, визуализации и клиентской аналитике."
  ogImage="/images/og/portfolio-banner.png"
  canonical={withBase('/')}
  activeNav="home"
  lang="ru"
  counterpartHref={withBase('en/')}
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section id="intro">
    <IntroShader />
    <div class="intro-container intro-container-slim">
      <div class="intro-content">
        <h1>Nikita Boyarkin</h1>
        <p class="tagline">Данные → решения. От гипотезы до ship-gate.</p>
        <div class="subtitle">Data Analyst / Product Analyst</div>

        <p class="cta-row">
          <a class="button" href={withBase('start/')}>С чего начать</a>
          <a class="button button-secondary" href={withBase('cv/')} target="_blank" rel="noopener">CV</a>
          <span class="cta-links">
            <a href="https://github.com/NikitaBoyarkin">GitHub</a> ·
            <a href="https://www.linkedin.com/in/nikita-boyarkin">LinkedIn</a> ·
            <a href={withBase('graph/')}>Граф</a>
          </span>
        </p>
      </div>
    </div>
  </section>

  <!-- KANBAN BOARD: Профиль | Проекты | Сейчас в работе -->
  <HomeBoard lang="ru" />

  <Manifesto />

  <TopicMap />

  <ProjectTimeline />

  <!-- GAMES ARCADE -->
  <section id="arcade" class="reveal" aria-label="Игры">
    <h2>🎮 Аркада</h2>
    <p>
      Мини-игры в браузере — и про аналитику тоже: A/B Test (догони p &lt; 0.05), Funnel Drop
      (лови пользователей в воронке), и классические Snake / 2048 / Pong. Работают на телефоне:
      свайпы, drag, тап.
    </p>
    <p>
      <a class="button" href={withBase('games/')}>Играть <ArrowMorph /></a>
    </p>
  </section>

  <CollaborationFormats />

  <MaterialStrip />
</Base>
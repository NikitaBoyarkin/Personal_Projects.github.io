---
import Base from '../layouts/Base.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import IntroShader from '../components/IntroShader.astro';
import TopicMap from '../components/TopicMap.astro';
import CollaborationFormats from '../components/CollaborationFormats.astro';
import { getCollection } from 'astro:content';
import BlogCard from '../components/BlogCard.astro';
import { withBase } from '../lib/path';
import { estimateReadTime } from '../lib/date';

const posts = (await getCollection('posts', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const volta = (await getCollection('projects', (p) => !p.data.draft)).find(
  (p) => p.id.replace(/\.md$/, '') === 'volta',
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nikita Boyarkin',
  url: 'https://nikitaboyarkin.github.io/Personal_Projects.github.io/',
  jobTitle: 'Data Analyst / Product Analyst',
  sameAs: [
    'https://github.com/NikitaBoyarkin',
    'https://www.linkedin.com/in/nikita-boyarkin',
  ],
};
---

<Base
  title="Nikita Boyarkin | Data Analyst / Product Analyst"
  description="Портфолио Никиты Бояркина — Data Analyst / Product Analyst. Проекты по SQL, Python, A/B-тестированию, визуализации и клиентской аналитике."
  ogImage="/images/00_profile.jpg"
  canonical={withBase('/')}
  activeNav="home"
  lang="ru"
  counterpartHref={withBase('en/')}
  jsonLd={jsonLd}
>
  <!-- INTRO -->
  <section id="intro" class="reveal">
    <IntroShader />
    <div class="intro-container">
      <div class="intro-content">
        <h1>Nikita Boyarkin</h1>
        <div class="subtitle">Data Analyst / Product Analyst</div>

        <div class="skills">
          <span class="skill-badge">SQL</span>
          <span class="skill-badge">Python</span>
          <span class="skill-badge">A/B Testing</span>
          <span class="skill-badge">Retention</span>
          <span class="skill-badge">Segmentation</span>
        </div>

        <p class="open-to">Открыт к Data / Product Analyst ролям.</p>
        <p class="thesis">
          Помогаю продуктовым командам принимать решения на данных: A/B-тесты с воспроизводимой
          методологией (CUPED, AA-тесты, Bonferroni, ship-gates), retention-аналитика и SQL-дашборды,
          которые не врут.
        </p>
        <p>
          4+ года на стыке продукта, данных и экспериментов. Petrograd — синтетика, методология — боевая.
        </p>

        <p class="cta-row">
          <a class="button" href={withBase('start/')}>С чего начать</a>
          <a class="button button-secondary" href={withBase('cv/')} target="_blank" rel="noopener">CV</a>
          <span class="cta-links">
            <a href="https://github.com/NikitaBoyarkin">GitHub</a> ·
            <a href="https://www.linkedin.com/in/nikita-boyarkin">LinkedIn</a> ·
            <a href={withBase('graph/')}>Граф</a>
          </span>
        </p>
      </div>
      <div class="intro-photo">
        <div class="photo-placeholder">
          <img
            src={withBase('images/00_profile.jpg')}
            alt="Nikita Boyarkin"
            class="profile-image"
            width="800"
            height="792"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  {
    volta && (
      <section id="featured" class="reveal reveal-delay-1" aria-label="Избранный проект">
        <h2>Избранный проект</h2>
        <article class="featured-project">
          {volta.data.hero && (
            <img
              class="featured-image"
              src={withBase(volta.data.hero)}
              alt={volta.data.title}
              width="1200"
              height="600"
              loading="eager"
              fetchpriority="high"
            />
          )}
          <div class="featured-body">
            <h3>{volta.data.title}</h3>
            <p>{volta.data.description}</p>
            {volta.data.impact && volta.data.impact.length > 0 && (
              <ul class="featured-impact">
                {volta.data.impact.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            <div class="featured-actions">
              <a class="button" href={withBase('projects/volta/')}>Смотреть проект</a>
              {volta.data.github && (
                <a
                  class="button button-secondary"
                  href={volta.data.github}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  GitHub
                </a>
              )}
            </div>
          </div>
        </article>
      </section>
    )
  }

  <TopicMap />

  <ProjectGrid excludeSlug="volta" heading="Проекты" />

  <CollaborationFormats />

  <!-- IN PROGRESS -->
  <section id="now-teaser" class="reveal reveal-delay-2" aria-label="Сейчас в работе">
    <h2>Сейчас в работе</h2>
    <ul class="now-list">
      <li class="now-item">
        <span class="now-dot"></span>
        Готовлюсь к BI / Data Analyst и Product Analyst middle-интервью: SQL, pandas, алгоритмы, моки.
      </li>
      <li class="now-item">
        <span class="now-dot"></span>
        Развиваю Obsidian knowledge base по product-аналитике — структурированный Zettelkasten с автоматизацией.
      </li>
      <li class="now-item">
        <span class="now-dot"></span>
        Экспериментирую с AI-assisted аналитическими workflow на Claude Code + MCP.
      </li>
    </ul>
    <p class="now-teaser-cta">
      <a href="https://t.me/lofinibo" target="_blank" rel="noopener noreferrer">Telegram: @lofinibo →</a>
    </p>
  </section>

  <style>
    .featured-project {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-8);
      align-items: center;
      padding: var(--space-8);
      background: var(--background-secondary);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-xl);
      box-shadow: 0 12px 40px var(--shadow-color);
    }
    .featured-image {
      width: 100%;
      height: auto;
      aspect-ratio: 2 / 1;
      object-fit: cover;
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-color);
    }
    .featured-body h3 {
      font-size: clamp(1.4rem, 1rem + 1.5vw, 2rem);
      margin: 0 0 var(--space-3);
      color: var(--text-normal);
    }
    .featured-body p {
      color: var(--text-muted);
      margin: 0 0 var(--space-4);
      line-height: 1.6;
    }
    .featured-impact {
      list-style: none;
      padding: 0;
      margin: 0 0 var(--space-6);
      display: grid;
      gap: var(--space-2);
    }
    .featured-impact li {
      position: relative;
      padding-left: var(--space-5);
      color: var(--text-normal);
      line-height: 1.5;
    }
    .featured-impact li::before {
      content: '▲';
      position: absolute;
      left: 0;
      color: var(--text-accent);
      font-size: 0.75em;
      top: 0.3em;
    }
    .featured-actions {
      display: flex;
      gap: var(--space-3);
      flex-wrap: wrap;
    }
    @media (max-width: 768px) {
      .featured-project {
        grid-template-columns: 1fr;
        gap: var(--space-5);
        padding: var(--space-5);
      }
    }
  </style>

  <!-- LATEST WRITING -->
  <section id="writing" class="reveal reveal-delay-1">
    <h2>Свежие записи</h2>
    <div class="blog-list">
      {
        posts.map((post) => (
          <BlogCard
            slug={post.id.replace(/\.md$/, '')}
            title={post.data.title}
            category={post.data.category}
            date={post.data.date}
            excerpt={post.data.excerpt}
            readTime={estimateReadTime(post.body)}
          />
        ))
      }
    </div>
    <p style="margin-top: 1.5rem;">
      <a href={withBase('writing/')}>Все записи →</a>
    </p>
  </section>

  <!-- ABOUT -->
  <section id="about" class="reveal reveal-delay-3">
    <h2>Обо мне</h2>
    <p>
      Работаю на стыке продукта, данных и экспериментов: клиентская аналитика, A/B-тестирование,
      дизайн дашбордов и пайплайны данных, которые помогают командам принимать решения быстрее.
    </p>
    <p>
      Вне работы поддерживаю Obsidian knowledge base по product-аналитике, экспериментирую с
      AI-assisted workflow и пишу о практических data-техниках.
    </p>
    <p>
      <a href={withBase('about/')}>Подробнее →</a>
    </p>
  </section>
</Base>
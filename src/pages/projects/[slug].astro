---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import InnerTOC from '../../components/InnerTOC.astro';
import { withBase } from '../../lib/path';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => !p.data.draft);
  const allPosts = await getCollection('posts', (p) => !p.data.draft);
  const allParts = await getCollection('volta-parts', (p) => !p.data.draft);
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, '') },
    props: { project, allPosts, allProjects: projects, allParts },
  }));
}

const { project, allPosts, allProjects, allParts } = Astro.props;
const { Content } = await render(project);
const slug = project.id.replace(/\.md$/, '');

// Резолвим related-пути вида /posts/<slug>/ и /projects/<slug>/ в { href, title }
const lookup = new Map<string, { kind: string; title: string }>();
[...allPosts, ...allProjects].forEach((x) => {
  const s = x.id.replace(/\.md$/, '');
  const kind = x.collection === 'projects' ? 'projects' : 'posts';
  lookup.set(s, { kind, title: x.data.title });
});

const related = (project.data.related ?? [])
  .map((p) => {
    const s = p.replace(/^\//, '').replace(/\/$/, '').replace(/^(posts|projects)\//, '');
    const found = lookup.get(s);
    return found ? { href: withBase(`${found.kind}/${s}/`), title: found.title } : null;
  })
  .filter((x): x is { href: string; title: string } => x !== null);

const children = (project.data.children ?? [])
  .map((c) => {
    const found = allParts.find((p) => p.data.part === c);
    return found ? { href: withBase(`projects/${slug}/${c}/`), title: found.data.title } : null;
  })
  .filter((x): x is { href: string; title: string } => x !== null);

const siteUrl = (Astro.site?.toString() || 'https://nikitaboyarkin.github.io').replace(/\/$/, '');
const projectJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.data.title,
  description: project.data.description,
  author: { '@type': 'Person', name: 'Nikita Boyarkin', url: `${siteUrl}${withBase('/')}` },
  url: `${siteUrl}${withBase(`projects/${slug}/`)}`,
  keywords: project.data.tools?.join(', '),
};
---

<Base
  title={`${project.data.title} | Nikita Boyarkin`}
  description={project.data.description}
  ogType="article"
  activeNav="home"
  canonical={withBase(`projects/${slug}/`)}
  lang="ru"
  jsonLd={projectJsonLd}
>
  <InnerTOC />

  <div class="container reveal">
    <a class="back" href={withBase('/')}>← Back to portfolio</a>

    {
      project.data.hero && (
        <img
          id="project-image"
          class="hero-image"
          src={withBase(project.data.hero)}
          alt={`${project.data.title} preview`}
          width="1200"
          height="600"
        />
      )
    }

    <div class="project-meta">
      {
        project.data.tools && project.data.tools.length > 0 && (
          <div class="project-meta-group">
            <span class="project-meta-label">Stack</span>
            <div class="project-tools project-tools-inline">
              {project.data.tools.map((tool) => (
                <span class="project-tool">{tool}</span>
              ))}
            </div>
          </div>
        )
      }

      {
        project.data.impact && project.data.impact.length > 0 && (
          <div class="project-meta-group">
            <span class="project-meta-label">Impact</span>
            <ul class="project-meta-list">
              {project.data.impact.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        project.data.github && (
          <div class="project-meta-group">
            <span class="project-meta-label">Source</span>
            <a
              class="project-meta-link"
              href={project.data.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              View on GitHub →
            </a>
          </div>
        )
      }
    </div>

    <article id="project-content">
      <Content />
    </article>

    {
      children.length > 0 && (
        <section class="post-related reveal reveal-delay-1" aria-label="Подробные разборы">
          <h2>Подробные разборы</h2>
          <ul>
            {children.map((c) => (
              <li><a href={c.href}>{c.title}</a></li>
            ))}
          </ul>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="post-related reveal reveal-delay-2" aria-label="Связанные материалы">
          <h2>Смотрите также</h2>
          <ul>
            {related.map((r) => (
              <li><a href={r.href}>{r.title}</a></li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>
---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/path';
import { METRICS } from '../lib/metrics';

// Telegram deep-link: pre-fills the message so the first contact carries context.
const tgDeepLink = `https://t.me/lofinibo?text=${encodeURIComponent('Привет! Прочитал value-страницу — обсудим сотрудничество.')}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: 'Nikita Boyarkin',
    jobTitle: 'Data Analyst / Product Analyst',
    sameAs: [
      'https://github.com/NikitaBoyarkin',
      'https://www.linkedin.com/in/nikita-boyarkin',
    ],
  },
};
---

<Base
  title="Чем могу быть полезен | Nikita Boyarkin"
  description="Чем могу быть полезен — найм и коллаборация. Количественный proof: A/B, retention, RFM, автоматизация. Один контакт — Telegram."
  canonical={withBase('value/')}
  activeNav="value"
  lang="ru"
  counterpartHref={withBase('en/value/')}
  jsonLd={jsonLd}
>
  <section class="container reveal">
    <h1>Чем могу быть полезен</h1>
    <p class="value-sub">Офферы + доказательства. Один контакт — Telegram.</p>

    <div class="value-proof">
      <div class="board-card value-metric">
        <b>+{METRICS.abKyc.deltaPp}pp</b>
        <span>A/B на KYC-шаге</span>
      </div>
      <div class="board-card value-metric">
        <b>+{METRICS.retention.deltaPp}pp</b>
        <span>Retention M3</span>
      </div>
      <div class="board-card value-metric">
        <b>{METRICS.rfm.revenueBeforePct}→{METRICS.rfm.revenueAfterPct}%</b>
        <span>Выручка в 4 ключевых сегментах</span>
      </div>
      <div class="board-card value-metric">
        <b>{METRICS.bot.hoursBefore}ч→{METRICS.bot.minutesAfter}мин</b>
        <span>Автоматизация еженедельного отчёта</span>
      </div>
      <div class="board-card value-metric">
        <b>{METRICS.portfolio.projects}</b>
        <span>Проектов в портфолио</span>
      </div>
    </div>

    <div class="board-card value-offer">
      <h2>💼 Найм</h2>
      <p>
        Data / Product Analyst, middle+. Флагманские кейсы: Volta (необанк), A/B-эксперименты,
        retention-анализ. Методология воспроизводимая: CUPED, AA-тесты, ship-gates.
      </p>
      <p class="value-links">
        <a href={withBase('cv/')}>CV →</a> ·
        <a href={withBase('projects/volta/')}>Кейс Volta →</a> ·
        <a href={withBase('projects/ab/')}>Кейс A/B →</a>
      </p>
    </div>

    <div class="board-card value-offer">
      <h2>🤝 Коллаборация</h2>
      <p>
        Кейсы, демо, граф знаний, игры — всё открыто: можно форкнуть, обсудить, переиспользовать.
        Пишу о практических data-техниках: A/B, когорты, RFM.
      </p>
      <p class="value-links">
        <a href={withBase('graph/')}>Граф знаний →</a> ·
        <a href={withBase('games/')}>Игры →</a> ·
        <a href="https://github.com/NikitaBoyarkin" data-analytics="value_github">GitHub →</a>
      </p>
    </div>

    <p class="cta-row">
      <a class="button" href={tgDeepLink} data-analytics="value_cta" target="_blank" rel="noopener noreferrer">Написать в Telegram →</a>
    </p>
  </section>

  <style>
    .value-sub {
      color: var(--text-muted);
      margin-top: -0.5rem;
    }
    .value-proof {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: var(--space-3);
      margin-top: var(--space-6);
    }
    .value-metric {
      text-align: center;
      padding: var(--space-4);
    }
    .value-metric b {
      display: block;
      font-size: 1.6rem;
      color: var(--text-accent);
      letter-spacing: -0.02em;
    }
    .value-metric span {
      display: block;
      margin-top: var(--space-2);
      font-size: 0.85rem;
      color: var(--text-muted);
      line-height: 1.4;
    }
    .value-offer {
      margin-top: var(--space-4);
      max-width: 60ch;
    }
    .value-offer h2 {
      margin: 0 0 var(--space-3);
      font-size: 1.05rem;
    }
    .value-offer p {
      margin: 0 0 var(--space-2);
      color: var(--text-muted);
      line-height: 1.6;
    }
    .value-links {
      margin: 0;
    }
  </style>
</Base>

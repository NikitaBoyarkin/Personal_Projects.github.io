---
import Base from '../layouts/Base.astro';
---

<Base title="Now & Contact | Nikita Boyarkin" description="What Nikita Boyarkin is focused on right now." activeNav="contact">
  <section class="now-section reveal">
    <h1 class="now-title">Now</h1>
    <p class="now-subtitle">What I'm focused on right now.</p>

    <ul class="now-list">
      <li class="now-item">
        <span class="now-dot"></span>
        Building an agentic data analysis pipeline using Claude Code and MCP servers
      </li>
      <li class="now-item">
        <span class="now-dot"></span>
        Reading: <em>Designing Machine Learning Systems</em> by Chip Huyen
      </li>
    </ul>
  </section>

  <section class="contact-section reveal reveal-delay-1">
    <h2 class="contact-title">Get in Touch</h2>
    <p class="contact-text">
      If you want to discuss product analytics, A/B testing, or just say hi — I'm always open to interesting
      conversations.
    </p>
    <a href="https://t.me/lofinibo" class="contact-email" target="_blank" rel="noopener noreferrer">Telegram: @lofinibo</a>

    <div class="linkedin-badge">
      <div class="badge-base LI-profile-badge" data-locale="en_US" data-size="medium" data-theme="light" data-type="VERTICAL" data-vanity="nikita-boyarkin" data-version="v1">
        <a class="badge-base__link LI-simple-link" href="https://ru.linkedin.com/in/nikita-boyarkin/en?trk=profile-badge">Nikita Boyarkin</a>
      </div>
    </div>
  </section>

  <script is:inline>
    // Match LinkedIn badge theme to current site theme before the badge script initializes.
    (function () {
      var badge = document.querySelector('.LI-profile-badge');
      if (!badge) return;
      var theme = document.documentElement.getAttribute('data-theme') || 'dark';
      badge.setAttribute('data-theme', theme === 'dark' ? 'dark' : 'light');
    })();
  </script>
  <script src="https://platform.linkedin.com/badges/js/profile.js" async defer is:inline></script>
</Base>

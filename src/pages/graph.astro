---
import Base from '../layouts/Base.astro';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';
import { withBase } from '../lib/path';
---

<Base
  title="Граф знаний | Nikita Boyarkin"
  description="Граф понятий product-аналитики: A/B-тестирование, retention, сегментация, SQL — и как они собираются в продуктовую петлю."
  canonical={withBase('graph/')}
  counterpartHref={withBase('en/graph/')}
  activeNav="home"
  lang="ru"
>
  <section class="container reveal">
    <h1 class="page-title">Граф знаний</h1>
    <p style="color: var(--text-muted); margin-bottom: var(--space-8); max-width: 64ch;">
      Карта понятий product-аналитики, которая стоит за проектами портфолио. Узлы — концепции и методы,
      рёбра — как они компонуются в петлю <strong>discover → validate → measure → optimize</strong>.
      Перетаскивайте узлы; двойной клик по холсту перезапускает симуляцию.
    </p>

    <KnowledgeGraph />

    <p style="color: var(--text-muted); margin-top: var(--space-8); font-size: 0.9rem;">
      Это curated-подграф domain-модели из моего Obsidian vault. Полный граф knowledge base — в работе.
    </p>
  </section>
</Base>
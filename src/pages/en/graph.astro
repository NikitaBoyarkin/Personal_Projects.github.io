---
import Base from '../../layouts/Base.astro';
import KnowledgeGraph from '../../components/KnowledgeGraph.astro';
import { withBase } from '../../lib/path';
---

<Base
  title="Knowledge graph | Nikita Boyarkin"
  description="A concept graph of product analytics: A/B testing, retention, segmentation, SQL — and how they compose into a product loop."
  canonical={withBase('en/graph/')}
  activeNav="home"
  lang="en"
>
  <section class="container reveal">
    <h1 class="page-title">Knowledge graph</h1>
    <p style="color: var(--text-muted); margin-bottom: var(--space-8); max-width: 64ch;">
      A map of the product-analytics concepts behind the portfolio projects. Nodes are concepts and methods;
      edges show how they compose into a <strong>discover → validate → measure → optimize</strong> loop.
      Drag nodes; double-click the canvas to restart the simulation.
    </p>

    <KnowledgeGraph lang="en" />

    <p style="color: var(--text-muted); margin-top: var(--space-8); font-size: 0.9rem;">
      A curated subgraph of the domain model from my Obsidian vault. The full knowledge-base graph is a work in progress.
    </p>
  </section>
</Base>
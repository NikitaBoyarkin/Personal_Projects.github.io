---
import Base from '../../layouts/Base.astro';
import HomeBoard from '../../components/HomeBoard.astro';
import IntroShader from '../../components/IntroShader.astro';
import Manifesto from '../../components/Manifesto.astro';
import ProjectTimeline from '../../components/ProjectTimeline.astro';
import CollaborationFormats from '../../components/CollaborationFormats.astro';
import MaterialStrip from '../../components/MaterialStrip.astro';
import AskMe from '../../components/AskMe.astro';
import CapabilitiesGrid from '../../components/CapabilitiesGrid.astro';
import HeroMetrics from '../../components/HeroMetrics.astro';
import HeroCta from '../../components/HeroCta.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/path';
import AudienceBar from '../../components/AudienceBar.astro';
import CareerSnapshot from '../../components/CareerSnapshot.astro';
import Testimonials from '../../components/Testimonials.astro';
import ReadingBlock from '../../components/ReadingBlock.astro';

const allProjects = await getCollection('projects-en', (p) => !p.data.draft);

const siteUrl = 'https://nikitaboyarkin.github.io/Personal_Projects.github.io/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'Nikita Boyarkin',
      url: siteUrl,
      jobTitle: 'Data Analyst / Product Analyst',
      sameAs: [
        'https://github.com/NikitaBoyarkin',
        'https://www.linkedin.com/in/nikita-boyarkin',
      ],
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Data Analyst / Product Analyst',
      },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'UMC',
      },
      knowsAbout: [
        'A/B testing',
        'Product analytics',
        'Retention analysis',
        'Customer segmentation (RFM)',
        'SQL',
        'Python',
        'Data visualization',
      ],
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', '.tagline'],
      },
    },
    {
      '@type': 'ItemList',
      name: 'Projects',
      numberOfItems: allProjects.length,
      itemListElement: allProjects.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.data.title,
        url: `${siteUrl}${withBase(`en/projects/${p.id.replace(/\.md$/, '')}/`)}`,
      })),
    },
  ],
};
---

<Base
  title="Nikita Boyarkin | Data Analyst / Product Analyst"
  description="Portfolio of Nikita Boyarkin — Data Analyst / Product Analyst. Projects in SQL, Python, A/B testing, visualization, and customer analytics."
  ogImage="/images/og/portfolio-banner.png"
  canonical={withBase('en/')}
  activeNav="home"
  lang="en"
  counterpartHref={withBase('/')}
  jsonLd={jsonLd}
>
  <!-- HERO — editorial split: identity left, dataviz panel right -->
  <section id="intro">
    <div class="intro-container hero-editorial">
      <div class="hero-body">
        <img
          class="hero-avatar"
          src={withBase('images/00_profile.webp')}
          alt="Nikita Boyarkin"
          width="72"
          height="72"
          loading="eager"
          fetchpriority="high"
        />
        <h1 class="hero-name">Nikita Boyarkin</h1>
        <p class="hero-role">Data / Product Analyst · SQL · Python · A/B testing</p>
        <p class="hero-pitch">
          Turning raw data into measurable product decisions — from hypothesis to metric to growth.
        </p>

        <HeroMetrics lang="en" />

        <p class="cta-row">
          <HeroCta lang="en" />
          <a class="button button-secondary" href={withBase('en/projects/')} data-analytics="hero_projects">Projects</a>
          <a class="button button-secondary" href={withBase('cv/')} target="_blank" rel="noopener" data-analytics="hero_cv">CV</a>
        </p>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <IntroShader />
        <dl class="hero-viz-cards">
          <div class="hero-viz-card">
            <dt>KYC conversion</dt>
            <dd>+6.24 pp</dd>
          </div>
          <div class="hero-viz-card">
            <dt>Annual fix impact</dt>
            <dd>€716K</dd>
          </div>
          <div class="hero-viz-card">
            <dt>Portfolio projects</dt>
            <dd>14</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Who's watching: audience switch reorders the stack below -->
  <AudienceBar lang="en" />

  <div class="home-stack">
    <div class="home-board" data-order-analyst="0" data-order-learner="0">
      <!-- KANBAN BOARD: Profile | Projects | Now -->
      <HomeBoard lang="en" />
    </div>

    <div class="home-career" data-order-analyst="6" data-order-learner="7">
      <!-- Experience + Education: grade claim and measured outcomes -->
      <CareerSnapshot lang="en" />
    </div>

    <div class="home-askme" data-order-analyst="7" data-order-learner="5">
      <!-- AI assistant "Ask me" (static, client-side) -->
      <AskMe lang="en" />
    </div>

    <div class="home-caps" data-order-analyst="1" data-order-learner="3">
      <!-- Capabilities grid: deliverables + measured results -->
      <CapabilitiesGrid lang="en" />
    </div>

    <div class="home-manifesto" data-order-analyst="6" data-order-learner="7">
      <Manifesto lang="en" />
    </div>

    <div class="home-timeline" data-order-analyst="2" data-order-learner="4">
      <ProjectTimeline lang="en" />
    </div>

    <div class="home-arcade" data-order-analyst="8" data-order-learner="8">
      <!-- GAMES ARCADE -->
      <section id="arcade" class="reveal" aria-label="Games">
        <h2>🎮 Arcade</h2>
        <p>
          Browser mini-games — including some about analytics: A/B Test (chase p &lt; 0.05), Funnel Drop
          (catch users through the funnel), plus classic Snake / 2048 / Pong. Works on phone too:
          swipe, drag, tap.
        </p>
        <p>
          <a class="button" href={withBase('games/')}>Play</a>
        </p>
      </section>
    </div>

    <div class="home-collab" data-order-analyst="5" data-order-learner="6">
      <CollaborationFormats lang="en" />
    </div>

    <!-- Testimonials: renders nothing until real recommendations are collected -->
    <div class="home-testimonials" data-order-analyst="7" data-order-learner="9">
      <Testimonials lang="en" />
    </div>

    <!-- Library / now reading -->
    <div class="home-library" data-order-analyst="8" data-order-learner="4">
      <ReadingBlock lang="en" />
    </div>

    <div class="home-strip" data-order-analyst="3" data-order-learner="1">
      <MaterialStrip lang="en" />
    </div>
  </div>
</Base>
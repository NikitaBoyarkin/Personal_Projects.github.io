---
import Base from '../../layouts/Base.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import IntroShader from '../../components/IntroShader.astro';
import CollaborationFormats from '../../components/CollaborationFormats.astro';
import MaterialStrip from '../../components/MaterialStrip.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/path';

const volta = (await getCollection('projects-en', (p) => !p.data.draft)).find(
  (p) => p.id.replace(/\.md$/, '') === 'volta',
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nikita Boyarkin',
  url: 'https://nikitaboyarkin.github.io/Personal_Projects.github.io/',
  jobTitle: 'Data Analyst / Product Analyst',
  sameAs: [
    'https://github.com/NikitaBoyarkin',
    'https://www.linkedin.com/in/nikita-boyarkin',
  ],
};
---

<Base
  title="Nikita Boyarkin | Data Analyst / Product Analyst"
  description="Portfolio of Nikita Boyarkin — Data Analyst / Product Analyst. Projects in SQL, Python, A/B testing, visualization, and customer analytics."
  ogImage="/images/00_profile.jpg"
  canonical={withBase('en/')}
  activeNav="home"
  lang="en"
  counterpartHref={withBase('/')}
  jsonLd={jsonLd}
>
  <!-- INTRO -->
  <section id="intro" class="reveal">
    <IntroShader />
    <div class="intro-container">
      <div class="intro-content">
        <h1>Nikita Boyarkin</h1>
        <div class="subtitle">Data Analyst / Product Analyst</div>

        <div class="skills">
          <span class="skill-badge">SQL</span>
          <span class="skill-badge">Python</span>
          <span class="skill-badge">A/B Testing</span>
          <span class="skill-badge">Retention</span>
          <span class="skill-badge">Segmentation</span>
        </div>

        <p class="open-to">Open to Data / Product Analyst roles.</p>
        <p class="thesis">
          I help product teams make decisions on data: A/B tests with reproducible methodology
          (CUPED, AA-tests, Bonferroni, ship-gates), retention analytics, and SQL dashboards that don't lie.
        </p>
        <p>
          4+ years at the intersection of product, data, and experimentation. Synthetic data, real methodology.
        </p>

        <p class="cta-row">
          <a class="button" href={withBase('en/start/')}>Start here</a>
          <a class="button button-secondary" href={withBase('cv/')} target="_blank" rel="noopener">CV</a>
          <span class="cta-links">
            <a href="https://github.com/NikitaBoyarkin">GitHub</a> ·
            <a href="https://www.linkedin.com/in/nikita-boyarkin">LinkedIn</a> ·
            <a href={withBase('en/graph/')}>Graph</a>
          </span>
        </p>
      </div>
      <div class="intro-photo">
        <div class="photo-placeholder">
          <img
            src={withBase('images/00_profile.jpg')}
            alt="Nikita Boyarkin"
            class="profile-image"
            width="800"
            height="792"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  {
    volta && (
      <section id="featured" class="reveal reveal-delay-1" aria-label="Featured project">
        <h2>Featured Project</h2>
        <article class="featured-project">
          {volta.data.hero && (
            <img
              class="featured-image"
              src={withBase(volta.data.hero)}
              alt={volta.data.title}
              width="1200"
              height="600"
              loading="eager"
              fetchpriority="high"
            />
          )}
          <div class="featured-body">
            <h3>{volta.data.title}</h3>
            <p>{volta.data.description}</p>
            {volta.data.impact && volta.data.impact.length > 0 && (
              <ul class="featured-impact">
                {volta.data.impact.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            <div class="featured-actions">
              <a class="button" href={withBase('en/projects/volta/')}>View Project</a>
              {volta.data.github && (
                <a
                  class="button button-secondary"
                  href={volta.data.github}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  GitHub
                </a>
              )}
            </div>
          </div>
        </article>
      </section>
    )
  }

  <ProjectGrid excludeSlug="volta" collection="projects-en" linkPrefix="en/" heading="Projects" />

  <CollaborationFormats lang="en" />

  <!-- IN PROGRESS -->
  <section id="now-teaser" class="reveal reveal-delay-2" aria-label="Now">
    <h2>Now</h2>
    <ul class="now-list">
      <li class="now-item">
        <span class="now-dot"></span>
        Preparing for BI / Data Analyst and Product Analyst mid-level interviews: SQL, pandas, algorithms, mocks.
      </li>
      <li class="now-item">
        <span class="now-dot"></span>
        Maintaining an Obsidian knowledge base on product analytics — a structured Zettelkasten with automation.
      </li>
      <li class="now-item">
        <span class="now-dot"></span>
        Experimenting with AI-assisted analytics workflows on Claude Code + MCP.
      </li>
    </ul>
    <p class="now-teaser-cta">
      <a href="https://t.me/lofinibo" target="_blank" rel="noopener noreferrer">Telegram: @lofinibo →</a>
    </p>
  </section>

  <style>
    .featured-project {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-8);
      align-items: center;
      padding: var(--space-8);
      background: var(--background-secondary);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-xl);
      box-shadow: 0 12px 40px var(--shadow-color);
    }
    .featured-image {
      width: 100%;
      height: auto;
      aspect-ratio: 2 / 1;
      object-fit: cover;
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-color);
    }
    .featured-body h3 {
      font-size: clamp(1.4rem, 1rem + 1.5vw, 2rem);
      margin: 0 0 var(--space-3);
      color: var(--text-normal);
    }
    .featured-body p {
      color: var(--text-muted);
      margin: 0 0 var(--space-4);
      line-height: 1.6;
    }
    .featured-impact {
      list-style: none;
      padding: 0;
      margin: 0 0 var(--space-6);
      display: grid;
      gap: var(--space-2);
    }
    .featured-impact li {
      position: relative;
      padding-left: var(--space-5);
      color: var(--text-normal);
      line-height: 1.5;
    }
    .featured-impact li::before {
      content: '▲';
      position: absolute;
      left: 0;
      color: var(--text-accent);
      font-size: 0.75em;
      top: 0.3em;
    }
    .featured-actions {
      display: flex;
      gap: var(--space-3);
      flex-wrap: wrap;
    }
    @media (max-width: 768px) {
      .featured-project {
        grid-template-columns: 1fr;
        gap: var(--space-5);
        padding: var(--space-5);
      }
    }
  </style>

  <MaterialStrip lang="en" />

  <!-- ABOUT -->
  <section id="about" class="reveal reveal-delay-3">
    <h2>About Me</h2>
    <p>
      I work at the intersection of product, data, and experimentation. My background spans customer analytics, A/B
      testing, dashboard design, and building data pipelines that help teams make faster decisions.
    </p>
    <p>
      Outside of work I maintain an Obsidian knowledge base on product analytics, experiment with AI-assisted workflows,
      and write about practical data techniques.
    </p>
    <p>
      <a href={withBase('en/about/')}>More →</a>
    </p>
  </section>
</Base>
---
import Base from '../../layouts/Base.astro';
import IntroShader from '../../components/IntroShader.astro';
import CapabilitiesGrid from '../../components/CapabilitiesGrid.astro';
import HeroMetrics from '../../components/HeroMetrics.astro';
import HeroCta from '../../components/HeroCta.astro';
import CareerSnapshot from '../../components/CareerSnapshot.astro';
import Testimonials from '../../components/Testimonials.astro';
import ReadingBlock from '../../components/ReadingBlock.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/path';

const allProjects = await getCollection('projects-en', (p) => !p.data.draft);
const featuredProject =
  allProjects.find((p) => p.id === 'posthog') || allProjects[0];

const siteUrl = 'https://nikitaboyarkin.github.io/Personal_Projects.github.io/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'Nikita Boyarkin',
      url: siteUrl,
      jobTitle: 'Data Analyst / Product Analyst',
      sameAs: [
        'https://github.com/NikitaBoyarkin',
        'https://www.linkedin.com/in/nikita-boyarkin',
      ],
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Data Analyst / Product Analyst',
      },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'UMC',
      },
      knowsAbout: [
        'A/B testing',
        'Product analytics',
        'Retention analysis',
        'Customer segmentation (RFM)',
        'SQL',
        'Python',
        'Data visualization',
      ],
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', '.tagline'],
      },
    },
    {
      '@type': 'ItemList',
      name: 'Projects',
      numberOfItems: allProjects.length,
      itemListElement: allProjects.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.data.title,
        url: `${siteUrl}${withBase(`en/projects/${p.id.replace(/\.md$/, '')}/`)}`,
      })),
    },
  ],
};
---

<Base
  title="Nikita Boyarkin | Data Analyst / Product Analyst"
  description="Portfolio of Nikita Boyarkin — Data Analyst / Product Analyst. Projects in SQL, Python, A/B testing, visualization, and customer analytics."
  ogImage="/images/og/portfolio-banner.png"
  canonical={withBase('en/')}
  activeNav="home"
  lang="en"
  counterpartHref={withBase('/')}
  jsonLd={jsonLd}
>
  <!-- HERO — editorial split: identity left, dataviz panel right -->
  <section id="intro">
    <div class="intro-container hero-editorial">
      <div class="hero-body">
        <img
          class="hero-avatar"
          src={withBase('images/00_profile.webp')}
          alt="Nikita Boyarkin"
          width="72"
          height="72"
          loading="eager"
          fetchpriority="high"
        />
        <h1 class="hero-name">Nikita Boyarkin</h1>
        <p class="hero-role">Data / Product Analyst · SQL · Python · A/B testing</p>
        <p class="hero-pitch">
          Turning raw data into measurable product decisions — from hypothesis to metric to growth.
        </p>

        <HeroMetrics lang="en" />

        <p class="cta-row">
          <HeroCta lang="en" />
          <a class="button button-secondary" href={withBase('en/projects/')} data-analytics="hero_projects">Projects</a>
          <a class="button button-secondary" href={withBase('cv/')} target="_blank" rel="noopener" data-analytics="hero_cv">CV</a>
        </p>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <IntroShader />
        <dl class="hero-viz-cards">
          <div class="hero-viz-card">
            <dt>KYC conversion</dt>
            <dd>+6.24 pp</dd>
          </div>
          <div class="hero-viz-card">
            <dt>Annual fix impact</dt>
            <dd>€716K</dd>
          </div>
          <div class="hero-viz-card">
            <dt>Portfolio projects</dt>
            <dd>14</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- EDITORIAL TOP + BENTO BOTTOM -->
  <div class="home-layout">
    <!-- Featured project -->
    <section class="editorial-section" id="featured-project" aria-labelledby="featured-heading">
      <h2 id="featured-heading">Featured project</h2>
      <p class="section-lead">
        One case that shows the full loop: metric → hypothesis → experiment → decision.
      </p>

      <article class="featured-card">
        <img
          class="featured-card-image"
          src={withBase(featuredProject.data.hero)}
          alt=""
          loading="lazy"
        />
        <div class="featured-card-body">
          <h3 class="featured-card-title">{featuredProject.data.title}</h3>
          <p class="featured-card-description">{featuredProject.data.description}</p>
          <div class="bento-chip-list">
            {featuredProject.data.tools?.slice(0, 5).map((tool: string) => (
              <span class="bento-chip">{tool}</span>
            ))}
          </div>
          <a
            class="featured-card-link"
            href={withBase(`en/projects/${featuredProject.id.replace(/\.md$/, '')}/`)}
            data-analytics="featured_project"
          >
            Read the case →
          </a>
        </div>
      </article>
    </section>

    <!-- Capabilities -->
    <section class="editorial-section" id="capabilities" aria-labelledby="capabilities-heading">
      <h2 id="capabilities-heading">What I do</h2>
      <p class="section-lead">
        Six capabilities, each with a concrete deliverable and a measured result.
      </p>
      <CapabilitiesGrid lang="en" />
    </section>

    <!-- Bento bottom -->
    <div class="bento-grid">
      <!-- Career snapshot -->
      <div class="bento-cell bento-cell-wide" tabindex="-1">
        <CareerSnapshot lang="en" />
      </div>

      <!-- Knowledge graph -->
      <div class="bento-cell" tabindex="-1">
        <h3 class="bento-cell-title">Knowledge graph</h3>
        <p class="bento-cell-heading">Explore the connections</p>
        <p class="bento-cell-text">
          All notes, projects, and topics are linked in an interactive graph. Find the path from SQL to A/B testing.
        </p>
        <a class="bento-cell-link" href={withBase('graph/')} data-analytics="bento_graph">
          Open graph →
        </a>
      </div>

      <!-- Reading / library -->
      <div class="bento-cell" tabindex="-1">
        <ReadingBlock lang="en" />
      </div>

      <!-- Notes -->
      <div class="bento-cell" tabindex="-1">
        <h3 class="bento-cell-title">Notes</h3>
        <p class="bento-cell-heading">Product analytics in writing</p>
        <p class="bento-cell-text">
          Methodology breakdowns, checklists, and templates for everyday analyst work.
        </p>
        <a class="bento-cell-link" href={withBase('en/writing/')} data-analytics="bento_notes">
          Read notes →
        </a>
      </div>

      <!-- Games / arcade -->
      <div class="bento-cell" tabindex="-1">
        <h3 class="bento-cell-title">Arcade</h3>
        <p class="bento-cell-heading">Games about analytics</p>
        <p class="bento-cell-text">
          Browser mini-games: A/B Test, Funnel Drop, Snake, 2048, Pong. Works on mobile too.
        </p>
        <a class="bento-cell-link" href={withBase('games/')} data-analytics="bento_arcade">
          Play →
        </a>
      </div>

      <!-- Testimonials -->
      <div class="bento-cell bento-cell-wide" tabindex="-1">
        <Testimonials lang="en" />
      </div>
    </div>
  </div>
</Base>

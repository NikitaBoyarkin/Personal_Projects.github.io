---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/path';
import { METRICS } from '../../lib/metrics';

// Telegram deep-link: pre-fills the message so the first contact carries context.
const tgDeepLink = `https://t.me/lofinibo?text=${encodeURIComponent('Hi! I read your value page — let\'s talk collaboration.')}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: 'Nikita Boyarkin',
    jobTitle: 'Data Analyst / Product Analyst',
    sameAs: [
      'https://github.com/NikitaBoyarkin',
      'https://www.linkedin.com/in/nikita-boyarkin',
    ],
  },
};
---

<Base
  title="How I can help | Nikita Boyarkin"
  description="How I can help — hiring and collaboration. Quantified proof: A/B, retention, RFM, automation. One contact — Telegram."
  canonical={withBase('en/value/')}
  activeNav="value"
  lang="en"
  counterpartHref={withBase('value/')}
  jsonLd={jsonLd}
>
  <section class="container reveal">
    <h1>How I can help</h1>
    <p class="value-sub">Offers + proof. One contact — Telegram.</p>

    <div class="value-proof">
      <div class="board-card value-metric">
        <b>+{METRICS.abKyc.deltaPp}pp</b>
        <span>A/B on the KYC step</span>
      </div>
      <div class="board-card value-metric">
        <b>+{METRICS.retention.deltaPp}pp</b>
        <span>M3 retention</span>
      </div>
      <div class="board-card value-metric">
        <b>{METRICS.rfm.revenueBeforePct}→{METRICS.rfm.revenueAfterPct}%</b>
        <span>Revenue in 4 key segments</span>
      </div>
      <div class="board-card value-metric">
        <b>{METRICS.bot.hoursBefore}h→{METRICS.bot.minutesAfter}min</b>
        <span>Weekly report automation</span>
      </div>
      <div class="board-card value-metric">
        <b>{METRICS.portfolio.projects}</b>
        <span>Portfolio projects</span>
      </div>
    </div>

    <div class="board-card value-offer">
      <h2>💼 Hiring</h2>
      <p>
        Data / Product Analyst, middle+. Flagship cases: Volta (neobank), A/B experiments,
        retention analysis. Reproducible methodology: CUPED, AA-tests, ship-gates.
      </p>
      <p class="value-links">
        <a href={withBase('cv/')}>CV →</a> ·
        <a href={withBase('en/projects/volta/')}>Volta case →</a> ·
        <a href={withBase('en/projects/ab/')}>A/B case →</a>
      </p>
    </div>

    <div class="board-card value-offer">
      <h2>🤝 Collaboration</h2>
      <p>
        Cases, demos, the knowledge graph, games — all open: fork, discuss, reuse.
        I write about practical data techniques: A/B, cohorts, RFM.
      </p>
      <p class="value-links">
        <a href={withBase('en/graph/')}>Knowledge graph →</a> ·
        <a href={withBase('games/')}>Games →</a> ·
        <a href="https://github.com/NikitaBoyarkin" data-analytics="value_github">GitHub →</a>
      </p>
    </div>

    <p class="cta-row">
      <a class="button" href={tgDeepLink} data-analytics="value_cta" target="_blank" rel="noopener noreferrer">Message me on Telegram →</a>
    </p>
  </section>

  <style>
    .value-sub {
      color: var(--text-muted);
      margin-top: -0.5rem;
    }
    .value-proof {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: var(--space-3);
      margin-top: var(--space-6);
    }
    .value-metric {
      text-align: center;
      padding: var(--space-4);
    }
    .value-metric b {
      display: block;
      font-size: 1.6rem;
      color: var(--text-accent);
      letter-spacing: -0.02em;
    }
    .value-metric span {
      display: block;
      margin-top: var(--space-2);
      font-size: 0.85rem;
      color: var(--text-muted);
      line-height: 1.4;
    }
    .value-offer {
      margin-top: var(--space-4);
      max-width: 60ch;
    }
    .value-offer h2 {
      margin: 0 0 var(--space-3);
      font-size: 1.05rem;
    }
    .value-offer p {
      margin: 0 0 var(--space-2);
      color: var(--text-muted);
      line-height: 1.6;
    }
    .value-links {
      margin: 0;
    }
  </style>
</Base>

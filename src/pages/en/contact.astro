---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/path';
---

<Base title="Contact | Nikita Boyarkin" description="Get in touch with Nikita Boyarkin — product analytics, A/B testing, collaboration." activeNav="contact" canonical={withBase('en/contact/')} lang="en" counterpartHref={withBase('contact/')}>
  <section class="contact-section reveal">
    <h1 class="contact-title">Contact</h1>
    <div class="board-card" style="max-width: 60ch;">
      <p class="contact-text">
        If you want to talk product analytics, A/B testing, or a collaboration format — I'm open to conversations.
        Open to Data / Product Analyst roles.
      </p>
      <a href="https://t.me/lofinibo" class="contact-email" target="_blank" rel="noopener noreferrer">Telegram: @lofinibo</a>

      <p style="margin-top: var(--space-6);">
        <a href={withBase('en/start/')}>Start here →</a> ·
        <a href={withBase('CV-Nikita-Boyarkin.pdf')}>CV (PDF)</a> ·
        <a href={withBase('contact/')}>Russian version</a>
      </p>
    </div>

    <div class="linkedin-badge">
      <div class="badge-base LI-profile-badge" data-locale="en_US" data-size="medium" data-theme="light" data-type="VERTICAL" data-vanity="nikita-boyarkin" data-version="v1">
        <a class="badge-base__link LI-simple-link" href="https://www.linkedin.com/in/nikita-boyarkin">Nikita Boyarkin</a>
      </div>
    </div>
  </section>

  <script is:inline>
    // Match LinkedIn badge theme to current site theme before the badge script initializes.
    (function () {
      var badge = document.querySelector('.LI-profile-badge');
      if (!badge) return;
      var theme = document.documentElement.getAttribute('data-theme') || 'dark';
      badge.setAttribute('data-theme', theme === 'dark' ? 'dark' : 'light');
    })();
  </script>
  <script src="https://platform.linkedin.com/badges/js/profile.js" async defer is:inline></script>
</Base>
---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/path';
import { getCollection } from 'astro:content';
import {
  computeTopicRows,
  groupRowsByLevel,
  LEVEL_LABELS,
  type TopicLevel,
} from '../../lib/topics';

const posts = await getCollection('posts', (p) => !p.data.draft);
const projects = await getCollection('projects', (p) => !p.data.draft);
const rows = computeTopicRows(posts, projects);
const groups = groupRowsByLevel(rows);

const LEVEL_BLURBS: Record<TopicLevel, string> = {
  junior: 'Базовый инструментарий аналитика.',
  middle: 'Продуктовая методология и прикладная аналитика.',
  senior: 'Продвинутые методы и системная ответственность.',
  meta: 'Карьера и развитие.',
};
---

<Base
  title="Темы | Nikita Boyarkin"
  description="Темы product-аналитики: A/B-тестирование, retention, сегментация, SQL, Python, автоматизация, карьера."
  canonical={withBase('topics/')}
  activeNav="home"
  lang="ru"
>
  <section class="container reveal">
    <h1 class="page-title">Темы</h1>
    <p style="color: var(--text-muted); margin-bottom: var(--space-8); max-width: 60ch;">
      Карта тем, которые покрывают проекты и записи портфолио. Сгруппированы по уровню владения;
      счётчик — число материалов по теме.
    </p>
    {
      groups.map((g) => (
        <div class="level-group">
          <div class="level-heading">
            <span class="level-name">{LEVEL_LABELS[g.level]}</span>
            <span class="level-blurb">{LEVEL_BLURBS[g.level]}</span>
          </div>
          <div class="topic-grid">
            {g.rows.map((r) => (
              <a class="topic-card" href={r.href}>
                <span class="topic-card-inner">
                  <span class="topic-label">{r.label}</span>
                  <span class="topic-blurb">{r.blurb}</span>
                </span>
                <span class="topic-count">{r.count}</span>
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </section>
</Base>

<style>
  .topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
  }
  .topic-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: var(--background-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-normal);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .topic-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--text-accent) 40%, transparent);
    box-shadow: 0 8px 20px var(--shadow-color);
  }
  .topic-card-inner {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .topic-label {
    font-weight: 500;
  }
  .topic-blurb {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .topic-count {
    flex-shrink: 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-accent);
    background: color-mix(in srgb, var(--text-accent) 10%, transparent);
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-full);
  }
</style>
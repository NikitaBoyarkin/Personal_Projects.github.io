---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import ProjectFilter from './ProjectFilter.astro';

interface Props {
  excludeSlug?: string;
  collection?: 'projects' | 'projects-en';
  linkPrefix?: string;
  heading?: string;
}
const { excludeSlug, collection = 'projects', linkPrefix = '', heading = 'Projects' } = Astro.props;
const lang: 'ru' | 'en' = linkPrefix.startsWith('en/') ? 'en' : 'ru';

const ORDER = ['volta', 'supabase', 'posthog', 'streamlit', 'sql', 'rfm', 'cohort', 'bot', 'scrolly', 'garden', 'site'];
const projects = (await getCollection(collection, (p) => !p.data.draft))
  .filter((p) => p.id.replace(/\.md$/, '') !== excludeSlug)
  .sort(
    (a, b) =>
      ORDER.indexOf(a.id.replace(/\.md$/, '')) - ORDER.indexOf(b.id.replace(/\.md$/, '')),
  );
---

<section id="projects" class="reveal reveal-delay-2">
  <h2>{heading}</h2>
  <ProjectFilter lang={lang} />
  <div id="project-list">
    {
      projects.map((project) => (
        <ProjectCard
          slug={project.id.replace(/\.md$/, '')}
          title={project.data.title}
          description={project.data.description}
          image={project.data.hero}
          impact={project.data.impact}
          tools={project.data.tools}
          github={project.data.github}
          demo={project.data.demo}
          private={project.data.private}
          linkPrefix={linkPrefix}
          lang={lang}
        />
      ))
    }
  </div>
</section>

---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import ProjectFilter from './ProjectFilter.astro';

interface Props {
  excludeSlug?: string;
}
const { excludeSlug } = Astro.props;

const ORDER = ['volta', 'sql', 'rfm', 'cohort', 'bot', 'garden', 'site'];
const projects = (await getCollection('projects', (p) => !p.data.draft))
  .filter((p) => p.id.replace(/\.md$/, '') !== excludeSlug)
  .sort(
    (a, b) =>
      ORDER.indexOf(a.id.replace(/\.md$/, '')) - ORDER.indexOf(b.id.replace(/\.md$/, '')),
  );
---

<section id="projects" class="reveal reveal-delay-2">
  <h2>Projects</h2>
  <ProjectFilter />
  <div id="project-list">
    {
      projects.map((project) => (
        <ProjectCard
          slug={project.id.replace(/\.md$/, '')}
          title={project.data.title}
          description={project.data.description}
          image={project.data.hero}
          impact={project.data.impact}
          tools={project.data.tools}
          github={project.data.github}
        />
      ))
    }
  </div>
</section>

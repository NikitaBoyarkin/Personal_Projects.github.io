---
// Hero primary CTA — deterministic after Phase 7. Control/test variant removed
// so the CTA always matches the agreed design tree: "Смотреть проекты" / "See my work".
// Tracking is handled via data-analytics in the parent page; see Analytics.astro.
import { withBase } from '../lib/path';

interface Props {
  lang?: 'ru' | 'en';
}
const { lang = 'ru' } = Astro.props;
const isEn = lang === 'en';
const label = isEn ? 'See my work' : 'Смотреть проекты';
const href = isEn ? withBase('en/projects/') : withBase('projects/');
---

<a
  id="hero-cta-primary"
  class="button"
  href={href}
  data-analytics="hero_projects"
>
  {label}
</a>

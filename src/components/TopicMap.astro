---
// Topic map with post/project counts — a compact analog of pimenov.ai's topic map.
// Counts + topic definitions live in src/lib/topics.ts (single source of truth).
import { withBase } from '../lib/path';
import { getCollection } from 'astro:content';
import { computeTopicRows } from '../lib/topics';

const posts = await getCollection('posts', (p) => !p.data.draft);
const projects = await getCollection('projects', (p) => !p.data.draft);
const rows = computeTopicRows(posts, projects);
---

<section id="topics" class="topic-map reveal reveal-delay-2" aria-label="Темы">
  <h2>Темы</h2>
  <div class="topic-grid">
    {
      rows.map((r) => (
        <a class="topic-card" href={r.href}>
          <span class="topic-label">{r.label}</span>
          <span class="topic-count">{r.count}</span>
        </a>
      ))
    }
  </div>
  <p class="topic-foot">
    <a href={withBase('topics/')}>Все темы →</a>
  </p>
</section>

<style>
  .topic-map {
    margin-bottom: var(--space-16);
  }
  .topic-map h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: var(--space-6);
    text-align: center;
    color: var(--text-normal);
  }
  .topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-3);
  }
  .topic-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    background: var(--background-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-normal);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .topic-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--text-accent) 40%, transparent);
    box-shadow: 0 8px 20px var(--shadow-color);
  }
  .topic-label {
    font-weight: 500;
    font-size: 0.95rem;
  }
  .topic-count {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-accent);
    background: color-mix(in srgb, var(--text-accent) 10%, transparent);
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-full);
  }
  .topic-foot {
    margin-top: var(--space-4);
    text-align: center;
  }
  .topic-foot a {
    color: var(--text-accent);
    text-decoration: none;
    font-weight: 500;
  }
</style>
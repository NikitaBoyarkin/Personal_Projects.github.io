---
// Capabilities grid — 6 deliverable-focused cards replacing the abstract
// skill-chip list. Each card: verb-title, concrete deliverable, metric/result,
// project link, inline stroke icon (same visual language as MorphIcon).
// Responsive: 3 columns desktop, 2 tablet, 1 mobile.
import { withBase } from "../lib/path";

interface Props {
  lang?: "ru" | "en";
}
const { lang = "ru" } = Astro.props;
const isEn = lang === "en";
const p = (href: string) => withBase(isEn ? `en/${href}` : href);

const I18N = {
  heading: isEn ? "What I can do" : "Что я умею",
  lead: isEn
    ? "Six capabilities, each with a concrete deliverable and a measured result."
    : "Шесть компетенций — у каждой конкретный результат и измеримый эффект.",
  open: isEn ? "Open case" : "Открыть кейс",
};

// Inline stroke icons (24×24, currentColor) — raw `d` strings.
const ICONS = {
  ab: "M9 3H5a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zM19 3h-4a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zM9 15H5a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2zM19 15h-4a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2z",
  retention: "M3 3v18h18M7 15l4-6 3 3 5-8",
  segmentation: "M21.21 15.89A10 10 0 1 1 8 2.83M22 12A10 10 0 0 0 12 2v10z",
  sql: "M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7zM9 12h.01M15 12h.01M12 22v-3",
  automation: "M12 8V4M8 4h8M4 8h16v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8zM8 14h.01M12 14h.01M16 14h.01",
  product: "M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM12 12l3-3",
};

const CARDS = [
  {
    id: "ab",
    icon: ICONS.ab,
    title: isEn ? "A/B testing" : "A/B-тестирование",
    deliverable: isEn
      ? "CUPED + AA + Bonferroni, a 3-condition ship-gate."
      : "CUPED + AA + Bonferroni, ship-gate из 3 условий.",
    metric: "+6.24pp KYC",
    href: p("projects/ab/"),
  },
  {
    id: "retention",
    icon: ICONS.retention,
    title: isEn ? "Retention analysis" : "Retention-анализ",
    deliverable: isEn
      ? "Cohort matrix + ARPU/LTV with an honest observation-age caveat."
      : "Когортная матрица + ARPU/LTV с честным caveat по возрасту наблюдения.",
    metric: isEn ? "12-month curves" : "12-месячные кривые",
    href: p("projects/cohort/"),
  },
  {
    id: "segmentation",
    icon: ICONS.segmentation,
    title: isEn ? "Segmentation" : "Сегментация",
    deliverable: isEn
      ? "RFM: 4 segments + targeted monetization actions."
      : "RFM: 4 сегмента + точечные действия по монетизации.",
    metric: isEn ? "12% → 41% of revenue" : "12% → 41% выручки",
    href: p("projects/rfm/"),
  },
  {
    id: "sql",
    icon: ICONS.sql,
    title: "SQL",
    deliverable: isEn
      ? "10 cases on DuckDB, ~183k events, one command."
      : "10 кейсов на DuckDB, ~183k событий, одной командой.",
    metric: isEn ? "sub-100ms queries" : "запросы sub-100ms",
    href: p("projects/sql/"),
  },
  {
    id: "automation",
    icon: ICONS.automation,
    title: isEn ? "Automation" : "Автоматизация",
    deliverable: isEn
      ? "Telegram bot: weekly report 1–2h → cron."
      : "Telegram-бот: еженедельный отчёт 1–2ч → cron.",
    metric: isEn ? "0 manual steps" : "0 ручных шагов",
    href: p("projects/bot/"),
  },
  {
    id: "product",
    icon: ICONS.product,
    title: isEn ? "Product metrics" : "Product-метрики",
    deliverable: isEn
      ? "Funnel + A/B + retention + segmentation in one loop."
      : "Funnel + A/B + retention + сегментация одной петлёй.",
    metric: "€716K/yr",
    href: p("projects/volta/"),
  },
];
---

<section id="capabilities" class="capabilities reveal" aria-label={I18N.heading}>
  <h2>{I18N.heading}</h2>
  <p class="capabilities-lead">{I18N.lead}</p>

  <div class="capability-grid">
    {
      CARDS.map((c) => (
        <a class="capability-card" href={c.href}>
          <svg
            class="capability-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={c.icon} />
          </svg>
          <h3 class="capability-title">{c.title}</h3>
          <p class="capability-deliverable">{c.deliverable}</p>
          <p class="capability-metric">{c.metric}</p>
          <span class="capability-link">{I18N.open} →</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .capabilities {
    margin: var(--space-16) 0;
  }
  .capabilities h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: var(--space-3);
    color: var(--text-normal);
  }
  .capabilities-lead {
    color: var(--text-muted);
    max-width: 60ch;
    margin-bottom: var(--space-10);
  }

  .capability-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .capability-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--background-secondary);
    text-decoration: none;
    color: var(--text-normal);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .capability-card:hover {
    transform: translateY(-3px);
    border-color: var(--text-accent);
    box-shadow: 0 12px 32px var(--shadow-color);
  }
  .capability-card:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }

  .capability-icon {
    width: 2rem;
    height: 2rem;
    color: var(--text-accent);
    margin-bottom: var(--space-2);
  }

  .capability-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-normal);
  }

  .capability-deliverable {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-muted);
    flex: 1;
  }

  .capability-metric {
    margin: var(--space-2) 0 0;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-accent);
    font-variant-numeric: tabular-nums;
  }

  .capability-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-accent);
  }

  @media (max-width: 1024px) {
    .capability-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .capability-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

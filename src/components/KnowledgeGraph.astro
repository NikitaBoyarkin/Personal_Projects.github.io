---
// Dependency-free force-directed knowledge graph island.
// Reads graph.json / graph-en.json (base-path aware via data-src) and renders
// an SVG simulation. Fullscreen toggle + wheel/pinch zoom + drag pan/zoom.
// Nodes are clickable (navigate to their page); hover highlights neighbors.
// Edge weight (0..1) drives spring length; edge type drives line style.
// Starts when scrolled into view; honors prefers-reduced-motion (static radial).
import { withBase } from '../lib/path';

interface Props {
  lang?: 'ru' | 'en';
}
const { lang = 'ru' } = Astro.props;
const isEn = lang === 'en';
const caption =
  isEn
    ? 'Content graph of the portfolio: projects, posts, topics and the Volta modules, linked by actual references. Built from the content collections at build time.'
    : 'Граф контента портфолио: проекты, записи, темы и модули Volta, связанные реальными ссылками. Собирается из коллекций контента на build-time.';
const ariaLabel = isEn
  ? 'Knowledge graph of portfolio content'
  : 'Граф контента портфолио';

const t = {
  zoomIn: isEn ? 'Zoom in' : 'Приблизить',
  zoomOut: isEn ? 'Zoom out' : 'Отдалить',
  reset: isEn ? 'Reset zoom and position' : 'Сбросить масштаб и положение',
  fullscreen: isEn ? 'Fullscreen' : 'Во весь экран',
  fullscreenExit: isEn ? 'Exit fullscreen' : 'Выйти из полноэкранного режима',
  open: isEn ? 'Open page' : 'Открыть страницу',
  searchPlaceholder: isEn ? 'Find a project or topic…' : 'Найти проект или тему…',
  searchLabel: isEn ? 'Search graph nodes' : 'Поиск по узлам графа',
  searchEmpty: isEn ? 'No matches' : 'Ничего не найдено',
  searchHint: isEn ? '↑↓ to navigate, Enter to center' : '↑↓ — навигация, Enter — центрировать',
  searchClear: isEn ? 'Clear search' : 'Очистить поиск',
  colorByGroup: isEn ? 'Track/Category' : 'Трек/Категория',
  colorByCommunity: isEn ? 'Community' : 'Комьюнити',
  colorMode: isEn ? 'Switch node colors: track/category or community' : 'Переключить цвет узлов: трек/категория или комьюнити',
  arrows: isEn ? 'Arrows' : 'Стрелки',
  arrowsLabel: isEn ? 'Show link direction' : 'Показать направление ссылок',
};
---

<div id="kg-root" class="kg-root" data-src={withBase(isEn ? 'graph-en.json' : 'graph.json')} data-search-empty={isEn ? 'No matches' : 'Ничего не найдено'} data-search-reset={isEn ? 'Clear search' : 'Очистить поиск'}>
  <div class="kg-topbar">
    <div class="kg-search" role="search">
      <input
        id="kg-search-input"
        class="kg-search-input"
        type="search"
        placeholder={t.searchPlaceholder}
        aria-label={t.searchLabel}
        autocomplete="off"
        role="combobox"
        aria-expanded="false"
        aria-controls="kg-search-results"
        aria-autocomplete="list"
      />
      <div id="kg-search-results" class="kg-search-results" role="listbox" hidden></div>
    </div>
    <div class="kg-legend" id="kg-legend" role="list" aria-label={isEn ? 'Graph color legend' : 'Легенда цветов графа'}></div>
    <div class="kg-controls" aria-label={isEn ? 'Graph controls' : 'Управление графом'}>
      <button type="button" class="kg-btn kg-btn-toggle" data-kg-action="toggle-color" aria-pressed="false" aria-label={t.colorMode} title={t.colorByGroup} data-label-group={t.colorByGroup} data-label-community={t.colorByCommunity}>{t.colorByGroup}</button>
      <button type="button" class="kg-btn kg-btn-toggle" data-kg-action="toggle-arrows" aria-pressed="false" aria-label={t.arrowsLabel} title={t.arrowsLabel}>{t.arrows}</button>
      <button type="button" class="kg-btn" data-kg-action="zoom-in" aria-label={t.zoomIn} title={t.zoomIn}>+</button>
      <button type="button" class="kg-btn" data-kg-action="zoom-out" aria-label={t.zoomOut} title={t.zoomOut}>−</button>
      <button type="button" class="kg-btn" data-kg-action="reset" aria-label={t.reset} title={t.reset}>⟲</button>
      <button type="button" class="kg-btn" data-kg-action="fullscreen" aria-label={t.fullscreen} title={t.fullscreen} data-label-fs={t.fullscreen} data-label-fs-exit={t.fullscreenExit}>⛶</button>
    </div>
  </div>
  <svg id="kg-svg" class="kg-svg" role="img" aria-label={ariaLabel}></svg>
  <p class="kg-caption">{caption}</p>
</div>

<script>
  import { GRAPH_GROUP_COLORS, GRAPH_COMMUNITY_COLORS, isDirected } from '../lib/graph';
  import { clampZoom, viewBoxOf, zoomAt, panBy, centerOn } from '../lib/graph-zoom';

  const rootEl = document.getElementById('kg-root');
  const svgEl = document.getElementById('kg-svg');
  const src = rootEl?.dataset.src;
  if (!rootEl || !svgEl || !src) throw new Error('kg-root / kg-svg not found');
  const root = rootEl as HTMLElement;
  const svg = svgEl as unknown as SVGSVGElement;

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const groupList = Object.keys(GRAPH_GROUP_COLORS);
  // Color mode: fixed track/category taxonomy vs emergent communities.
  let mode: 'group' | 'community' = 'group';
  // Obsidian "Arrows": show link direction on directed edge types.
  let showArrows = false;
  // Obsidian "Tags" filter: groups hidden via legend checkboxes.
  let hiddenGroups = new Set<string>();
  let communities: number[] = [];
  let communityLabels = new Map<number, string>();
  const colorFor = (n: any) =>
    mode === 'community'
      ? GRAPH_COMMUNITY_COLORS[(n.community ?? 0) % GRAPH_COMMUNITY_COLORS.length]
      : GRAPH_GROUP_COLORS[n.group] || 'var(--text-muted)';
  const legendEl = document.getElementById('kg-legend') as HTMLDivElement | null;
  function renderLegend() {
    if (!legendEl) return;
    legendEl.replaceChildren();
    const isCommunity = mode === 'community';
    const items = isCommunity
      ? communities.map((c) => ({
          key: communityLabels.get(c) ?? `#${c}`,
          color: GRAPH_COMMUNITY_COLORS[c % GRAPH_COMMUNITY_COLORS.length],
        }))
      : groupList.map((g) => ({ key: g, color: GRAPH_GROUP_COLORS[g] }));
    for (const it of items) {
      const span = document.createElement('span');
      span.className = 'kg-legend-item';
      const i = document.createElement('i');
      i.style.background = it.color;
      span.appendChild(i);
      if (isCommunity) {
        span.appendChild(document.createTextNode(it.key));
      } else {
        // Obsidian "Tags" filter: checkbox chips show/hide a whole group.
        const label = document.createElement('label');
        label.className = 'kg-legend-toggle';
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.checked = !hiddenGroups.has(it.key);
        cb.setAttribute('aria-label', it.key);
        cb.addEventListener('change', () => {
          if (cb.checked) {
            hiddenGroups.delete(it.key);
          } else {
            // Never hide the last visible group — an empty graph is noise.
            if (hiddenGroups.size + 1 >= groupList.length) {
              cb.checked = true;
              return;
            }
            hiddenGroups.add(it.key);
          }
          applyGroupFilter();
        });
        label.appendChild(cb);
        label.appendChild(document.createTextNode(it.key));
        span.appendChild(label);
      }
      legendEl.appendChild(span);
    }
  }

  /** Obsidian "Tags" filter: hide/show whole groups (and their edges). */
  function applyGroupFilter() {
    nodes.forEach((n, i) => {
      nodeEls[i].style.display = hiddenGroups.has(n.group) ? 'none' : '';
    });
    edges.forEach((e, i) => {
      const l = links[i];
      e.style.display =
        hiddenGroups.has(l.source.group) || hiddenGroups.has(l.target.group) ? 'none' : '';
    });
  }
  const NS = 'http://www.w3.org/2000/svg';
  const el = (name: string) => document.createElementNS(NS, name);
  // Base path derived from the data URL (e.g. /Personal_Projects.github.io/graph.json).
  const base = src.slice(0, src.lastIndexOf('/')) + '/';

  let world = { w: 600, h: 460 };
  let vp = { x: 0, y: 0, k: 1 };
  let nodes: any[] = [];
  let nodeEls: SVGGElement[] = [];
  let links: { source: any; target: any; weight: number; type: string }[] = [];
  let edges: SVGLineElement[] = [];
  let running = false;
  let frames = 0;
  let restart: (() => void) | null = null;
  let dragging: any = null;
  let dragStart: { x: number; y: number } | null = null;
  let moved = false;
  let hoveredId: string | null = null;
  let panning: { startX: number; startY: number; vpX: number; vpY: number } | null = null;
  let pinch: { startDist: number; vp0: typeof vp; mid0: { x: number; y: number } } | null = null;
  const pointers = new Map<number, { x: number; y: number }>();

  function applyViewport() {
    const vb = viewBoxOf(vp, world);
    svg.setAttribute('viewBox', `${vb.x} ${vb.y} ${vb.w} ${vb.h}`);
  }

  function resetViewport() {
    vp = centerOn({ x: 0, y: 0, k: 1 }, { x: world.w / 2, y: world.h / 2 }, 1, world);
    applyViewport();
  }

  /** Convert a client (screen) point into world/viewBox coordinates. */
  function toWorld(clientX: number, clientY: number) {
    const ctm = svg.getScreenCTM();
    if (!ctm) return { x: 0, y: 0 };
    const pt = new DOMPoint(clientX, clientY).matrixTransform(ctm.inverse());
    return { x: pt.x, y: pt.y };
  }

  const EDGE_STYLE: Record<string, string> = {
    related: '',
    children: '',
    topic: '6 4',
    shared: '2 3',
  };
  const EDGE_COLOR: Record<string, string> = {
    related: 'color-mix(in srgb, var(--text-accent) 65%, transparent)',
    children: 'color-mix(in srgb, var(--text-normal) 55%, transparent)',
    topic: 'color-mix(in srgb, var(--text-muted) 45%, transparent)',
    shared: 'color-mix(in srgb, var(--text-muted) 35%, transparent)',
  };

  function rebuild(data: any) {
    svg.replaceChildren();
    world = { w: svg.clientWidth || 600, h: 460 };

    // Arrowhead marker for directed edges (Obsidian "Arrows" display option).
    const defs = el('defs');
    const marker = el('marker');
    marker.setAttribute('id', 'kg-arrow');
    marker.setAttribute('viewBox', '0 0 10 10');
    marker.setAttribute('refX', '8');
    marker.setAttribute('refY', '5');
    marker.setAttribute('markerWidth', '6');
    marker.setAttribute('markerHeight', '6');
    // Constant arrowhead size regardless of edge stroke-width (the default
    // markerUnits="strokeWidth" would scale arrows with link thickness).
    marker.setAttribute('markerUnits', 'userSpaceOnUse');
    marker.setAttribute('orient', 'auto-start-reverse');
    const arrowPath = el('path');
    arrowPath.setAttribute('d', 'M 0 0 L 10 5 L 0 10 z');
    arrowPath.setAttribute('fill', 'var(--text-muted)');
    marker.appendChild(arrowPath);
    defs.appendChild(marker);
    svg.appendChild(defs);

    nodes = data.nodes.map((n: any) => ({
      ...n,
      x: 0,
      y: 0,
      vx: 0,
      vy: 0,
    }));
    // Initial positions: ring per group around the center (same idea as the
    // reduced-motion radial layout below). The force simulation then only has
    // to refine a near-converged layout instead of pulling a random scatter
    // together — which is what made it run ~15s and visibly shake.
    const groups: Record<string, any[]> = {};
    nodes.forEach((n) => {
      (groups[n.group] = groups[n.group] || []).push(n);
    });
    const groupKeys = Object.keys(groups);
    const cx = world.w / 2;
    const cy = world.h / 2;
    const ringRadius = Math.min(world.w, world.h) * 0.35;
    groupKeys.forEach((gk, gi) => {
      const ga = (groupKeys.length === 1 ? 0 : (gi / groupKeys.length) * 2 * Math.PI) - Math.PI / 2;
      const gx = cx + Math.cos(ga) * ringRadius;
      const gy = cy + Math.sin(ga) * ringRadius;
      groups[gk].forEach((n, ni) => {
        const a = (ni / Math.max(1, groups[gk].length)) * 2 * Math.PI;
        const r = 30 + ni * 10;
        n.x = gx + Math.cos(a) * r;
        n.y = gy + Math.sin(a) * r;
      });
    });
    const idx = new Map(nodes.map((n) => [n.id, n]));
    links = data.links
      .map((l: any) => ({
        source: idx.get(l.source),
        target: idx.get(l.target),
        weight: typeof l.weight === 'number' ? l.weight : 1,
        type: l.type || 'related',
      }))
      .filter((l: any) => l.source && l.target);

    const edgeLayer = el('g');
    svg.appendChild(edgeLayer);
    edges = links.map((l) => {
      const line = el('line');
      line.setAttribute('class', 'kg-edge');
      line.setAttribute('stroke', EDGE_COLOR[l.type] || EDGE_COLOR.related);
      const dash = EDGE_STYLE[l.type];
      if (dash) line.setAttribute('stroke-dasharray', dash);
      // Obsidian "Link thickness": strong edges draw thicker.
      line.style.strokeWidth = String(0.6 + 1.6 * (l.weight || 1));
      if (showArrows && isDirected(l.type)) {
        line.setAttribute('marker-end', 'url(#kg-arrow)');
      }
      edgeLayer.appendChild(line);
      return line as SVGLineElement;
    });

    const nodeLayer = el('g');
    svg.appendChild(nodeLayer);
    nodeEls = nodes.map((n) => {
      const g = el('g');
      g.setAttribute('tabindex', '0');
      g.setAttribute('role', 'link');
      g.setAttribute('aria-label', n.label);
      g.style.cursor = 'pointer';
      const r = n.size || 6;
      const c = el('circle');
      c.setAttribute('r', String(r));
      c.setAttribute('fill', colorFor(n));
      const txt = el('text');
      txt.setAttribute('x', String(r + 6));
      txt.setAttribute('y', '4');
      txt.setAttribute('class', 'kg-label');
      txt.textContent = n.label;
      g.appendChild(c);
      g.appendChild(txt);
      nodeLayer.appendChild(g);
      return g as SVGGElement;
    });

    resetViewport();
  }

  // --- Hover: highlight neighbors; the label appears via CSS on hover/focus ---
  const adjacency = new Map<string, Set<string>>();

  function clearHighlight() {
    hoveredId = null;
    nodes.forEach((_, i) => nodeEls[i].style.opacity = '');
    edges.forEach((e) => (e.style.opacity = ''));
  }

  function highlight(id: string) {
    const neighbors = adjacency.get(id) || new Set<string>();
    neighbors.add(id);
    nodes.forEach((n, i) => {
      nodeEls[i].style.opacity = neighbors.has(n.id) ? '1' : '0.12';
    });
    edges.forEach((e, i) => {
      const l = links[i];
      const on = l.source.id === id || l.target.id === id;
      e.style.opacity = on ? String(Math.min(1, (l.weight || 1) * 0.9 + 0.2)) : '0.05';
    });
  }

  function navigateTo(n: any) {
    if (n?.url) window.location.href = `${base}${n.url}`;
  }

  function renderStatic(data: any) {
    rebuild(data);
    // Radial layout by group, centered.
    const groups: Record<string, any[]> = {};
    nodes.forEach((n) => {
      (groups[n.group] = groups[n.group] || []).push(n);
    });
    const cx = world.w / 2;
    const cy = world.h / 2;
    const groupKeys = Object.keys(groups);
    const radius = Math.min(world.w, world.h) * 0.38;
    const pos: Record<string, { x: number; y: number }> = {};
    groupKeys.forEach((gk, gi) => {
      const ga = (groupKeys.length === 1 ? 0 : (gi / groupKeys.length) * 2 * Math.PI) - Math.PI / 2;
      const gx = cx + Math.cos(ga) * radius;
      const gy = cy + Math.sin(ga) * radius;
      groups[gk].forEach((n, ni) => {
        const a = (ni / Math.max(1, groups[gk].length)) * 2 * Math.PI;
        const r = 34 + ni * 12;
        pos[n.id] = { x: gx + Math.cos(a) * r, y: gy + Math.sin(a) * r };
      });
    });
    links.forEach((l, i) => {
      const a = pos[l.source.id], b = pos[l.target.id];
      if (!a || !b) return;
      const dx = b.x - a.x, dy = b.y - a.y;
      const d = Math.sqrt(dx * dx + dy * dy) || 1;
      // Stop the line at the target's edge so arrowheads (and lines) don't
      // hide under the node circle.
      const r = (l.target.size || 6) + 2;
      edges[i].setAttribute('x1', String(a.x));
      edges[i].setAttribute('y1', String(a.y));
      edges[i].setAttribute('x2', String(b.x - (dx / d) * r));
      edges[i].setAttribute('y2', String(b.y - (dy / d) * r));
    });
    nodes.forEach((n, i) => {
      const p = pos[n.id];
      if (p) nodeEls[i].setAttribute('transform', `translate(${p.x},${p.y})`);
    });
  }

  function renderForce(data: any) {
    rebuild(data);

    // Scale simulation constants with node count so the layout stays sparse
    // and readable whether the graph has 10 or 200 nodes.
    const N = Math.max(1, nodes.length);
    const charge = 2200 * Math.sqrt(N);          // repulsion grows with N
    const gravity = 0.004 + 0.001 * Math.sqrt(N); // pull-to-center grows mildly
    const damp = 0.86;
    const margin = Math.min(80, 60 + N * 0.5);
    // Alpha-based settling (d3-force style): every force scales with `alpha`,
    // which decays exponentially each tick, so the layout converges and stops
    // on its own (~2–3s) instead of running a fixed frame count and shaking.
    const alphaDecay = Math.max(0.015, 0.03 - 0.001 * Math.sqrt(N));
    const alphaMin = 0.01;
    const maxFrames = Math.max(400, N * 10);      // safety cap; alpha stops first
    let alpha = 1;

    function tick() {
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i], b = nodes[j];
          let dx = a.x - b.x, dy = a.y - b.y;
          let d2 = dx * dx + dy * dy || 1;
          let d = Math.sqrt(d2);
          const f = (charge / d2) * alpha;
          a.vx += (dx / d) * f; a.vy += (dy / d) * f;
          b.vx -= (dx / d) * f; b.vy -= (dy / d) * f;
        }
      }
      links.forEach((l) => {
        const dx = l.target.x - l.source.x, dy = l.target.y - l.source.y;
        const d = Math.sqrt(dx * dx + dy * dy) || 1;
        // Stronger edges pull closer: ideal length shrinks with weight.
        const ideal = 60 + 80 * (1 - (l.weight || 1));
        const f = (d - ideal) * 0.04 * (0.5 + 0.5 * (l.weight || 1)) * alpha;
        const fx = (dx / d) * f, fy = (dy / d) * f;
        l.source.vx += fx; l.source.vy += fy;
        l.target.vx -= fx; l.target.vy -= fy;
      });
      nodes.forEach((n) => {
        if (n.fx != null) { n.x = n.fx; n.y = n.fy; n.vx = 0; n.vy = 0; return; }
        n.vx += (world.w / 2 - n.x) * gravity * alpha;
        n.vy += (world.h / 2 - n.y) * gravity * alpha;
        n.vx *= damp; n.vy *= damp;
        n.x += n.vx; n.y += n.vy;
        n.x = Math.max(margin, Math.min(world.w - margin, n.x));
        n.y = Math.max(margin, Math.min(world.h - margin, n.y));
      });
      links.forEach((l, i) => {
        const dx = l.target.x - l.source.x, dy = l.target.y - l.source.y;
        const d = Math.sqrt(dx * dx + dy * dy) || 1;
        // Stop the line at the target's edge so arrowheads (and lines) don't
        // hide under the node circle.
        const r = (l.target.size || 6) + 2;
        edges[i].setAttribute('x1', String(l.source.x));
        edges[i].setAttribute('y1', String(l.source.y));
        edges[i].setAttribute('x2', String(l.target.x - (dx / d) * r));
        edges[i].setAttribute('y2', String(l.target.y - (dy / d) * r));
      });
      nodes.forEach((n, i) => nodeEls[i].setAttribute('transform', `translate(${n.x},${n.y})`));
    }

    function loop() {
      if (!running) return;
      tick();
      frames++;
      alpha *= 1 - alphaDecay;  // exponential decay → natural settle
      if (alpha < alphaMin || frames > maxFrames) running = false;
      requestAnimationFrame(loop);
    }

    restart = () => {
      running = true;
      frames = 0;
      alpha = 1;
      loop();
    };
    restart();
  }

  svg.addEventListener('dblclick', () => {
    if (reduced || !restart) return;
    restart();
  });

  // --- Pointer handling: node drag (click = navigate), canvas pan, pinch ---
  function handlePointerDown(e: PointerEvent) {
    svg.setPointerCapture(e.pointerId);
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

    if (pointers.size === 2) {
      dragging = null;
      panning = null;
      const [a, b] = [...pointers.values()];
      const startDist = Math.hypot(a.x - b.x, a.y - b.y);
      pinch = {
        startDist: Math.max(1, startDist),
        vp0: { ...vp },
        mid0: toWorld((a.x + b.x) / 2, (a.y + b.y) / 2),
      };
      return;
    }

    // Single pointer: node drag if it hit a node, else canvas pan.
    const target = nodeEls.find((g) => g.contains(e.target as Node));
    if (target) {
      const n = nodes[nodeEls.indexOf(target)];
      const p = toWorld(e.clientX, e.clientY);
      dragging = n;
      dragStart = { x: p.x, y: p.y };
      moved = false;
      n.fx = p.x;
      n.fy = p.y;
      target.style.cursor = 'grabbing';
      return;
    }
    panning = { startX: e.clientX, startY: e.clientY, vpX: vp.x, vpY: vp.y };
    svg.style.cursor = 'grabbing';
  }

  function handlePointerMove(e: PointerEvent) {
    if (!pointers.has(e.pointerId)) return;
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

    if (pinch && pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      const dist = Math.hypot(a.x - b.x, a.y - b.y);
      const factor = clampZoom((pinch.vp0.k * dist) / pinch.startDist) / pinch.vp0.k;
      vp = zoomAt(pinch.vp0, pinch.mid0, factor, world);
      applyViewport();
      return;
    }

    if (dragging) {
      const p = toWorld(e.clientX, e.clientY);
      const dx = p.x - (dragStart?.x ?? p.x);
      const dy = p.y - (dragStart?.y ?? p.y);
      if (dx * dx + dy * dy > 9) moved = true;
      dragging.fx = p.x;
      dragging.fy = p.y;
      return;
    }

    if (panning) {
      const p = toWorld(e.clientX, e.clientY);
      const start = toWorld(panning.startX, panning.startY);
      // Keep the world point grabbed at start under the cursor.
      vp = panBy({ x: panning.vpX, y: panning.vpY, k: vp.k }, start.x - p.x, start.y - p.y);
      applyViewport();
    }
  }

  function handlePointerUp(e: PointerEvent) {
    pointers.delete(e.pointerId);
    if (pointers.size < 2) pinch = null;
    if (dragging) {
      const n = dragging;
      const wasClick = !moved;
      n.fx = null;
      n.fy = null;
      const g = nodeEls[nodes.indexOf(n)];
      if (g) g.style.cursor = 'pointer';
      dragging = null;
      dragStart = null;
      if (wasClick) navigateTo(n);
      return;
    }
    if (panning) {
      panning = null;
      svg.style.cursor = '';
    }
  }

  svg.addEventListener('pointerdown', handlePointerDown);
  svg.addEventListener('pointermove', handlePointerMove);
  svg.addEventListener('pointerup', handlePointerUp);
  svg.addEventListener('pointercancel', handlePointerUp);

  // Hover: highlight neighbors; the label appears via CSS on hover/focus.
  svg.addEventListener('pointerover', (e) => {
    const target = nodeEls.find((g) => g.contains(e.target as Node));
    if (!target) {
      clearHighlight();
      return;
    }
    const n = nodes[nodeEls.indexOf(target)];
    hoveredId = n.id;
    highlight(n.id);
  });
  svg.addEventListener('pointerout', (e) => {
    const stillIn = (e.relatedTarget as Node | null) && svg.contains(e.relatedTarget as Node);
    if (!stillIn) clearHighlight();
  });

  // Keyboard: Enter/Space on a focused node navigates.
  nodeEls.forEach((g, i) => {
    g.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        navigateTo(nodes[i]);
      }
    });
  });

  // Wheel zoom around the cursor.
  svg.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      const p = toWorld(e.clientX, e.clientY);
      const factor = e.deltaY < 0 ? 1.15 : 1 / 1.15;
      vp = zoomAt(vp, p, factor, world);
      applyViewport();
    },
    { passive: false },
  );

  // --- Search: filter nodes by label, center on a match ---
  const searchInput = document.getElementById('kg-search-input') as HTMLInputElement | null;
  const searchResults = document.getElementById('kg-search-results') as HTMLDivElement | null;
  let searchActive = -1;

  function applySearchFilter(query: string) {
    const q = query.trim().toLowerCase();
    nodes.forEach((n, i) => {
      const match = !q || n.label.toLowerCase().includes(q);
      nodeEls[i].style.opacity = match ? '' : '0.08';
    });
  }

  function renderSearchResults(query: string) {
    if (!searchResults) return;
    const q = query.trim().toLowerCase();
    searchResults.innerHTML = '';
    if (!q) {
      searchResults.hidden = true;
      return;
    }
    const matches = nodes.filter((n) => n.label.toLowerCase().includes(q)).slice(0, 12);
    searchResults.hidden = false;
    searchActive = -1;
    if (matches.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'kg-search-empty';
      empty.textContent = root.dataset.searchEmpty || 'No matches';
      // Empty state needs one clear next action: a button that clears the
      // query and restores the full graph.
      const reset = document.createElement('button');
      reset.type = 'button';
      reset.className = 'kg-search-empty-btn';
      reset.textContent = root.dataset.searchReset || 'Clear search';
      reset.addEventListener('click', () => {
        if (!searchInput) return;
        searchInput.value = '';
        searchInput.setAttribute('aria-expanded', 'false');
        applySearchFilter('');
        searchResults.hidden = true;
        searchInput.focus();
      });
      empty.appendChild(reset);
      searchResults.appendChild(empty);
      return;
    }
    matches.forEach((n, _i) => {
      const item = document.createElement('button');
      item.type = 'button';
      item.className = 'kg-search-item';
      item.setAttribute('role', 'option');
      item.textContent = n.label;
      item.addEventListener('click', () => {
        centerOnNode(n.id);
        searchInput?.blur();
      });
      searchResults.appendChild(item);
    });
  }

  function centerOnNode(id: string) {
    const n = nodes.find((x) => x.id === id);
    if (!n) return;
    // Un-hide the node's group so a search hit is always visible.
    if (hiddenGroups.has(n.group)) {
      hiddenGroups.delete(n.group);
      renderLegend();
      applyGroupFilter();
    }
    // Recenter the viewport on the node's current position with a comfortable zoom.
    vp = centerOn(vp, { x: n.x, y: n.y }, Math.max(1.5, vp.k), world);
    applyViewport();
    clearSearch();
    // Flash highlight so the user sees which node was found.
    hoveredId = n.id;
    highlight(n.id);
    const g = nodeEls[nodes.indexOf(n)];
    if (g) g.focus();
    window.setTimeout(() => {
      if (hoveredId === n.id) clearHighlight();
    }, 2500);
  }

  function clearSearch() {
    if (searchInput) {
      searchInput.value = '';
      searchInput.setAttribute('aria-expanded', 'false');
    }
    if (searchResults) searchResults.hidden = true;
    applySearchFilter('');
  }

  if (searchInput && searchResults) {
    searchInput.addEventListener('input', () => {
      const q = searchInput.value;
      searchInput.setAttribute('aria-expanded', 'true');
      renderSearchResults(q);
      applySearchFilter(q);
    });
    searchInput.addEventListener('keydown', (e) => {
      const items = Array.from(searchResults.querySelectorAll<HTMLButtonElement>('.kg-search-item'));
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        searchActive = (searchActive + 1) % Math.max(1, items.length);
        items[searchActive]?.focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        searchActive = (searchActive - 1 + items.length) % Math.max(1, items.length);
        items[searchActive]?.focus();
      } else if (e.key === 'Enter') {
        if (items[Math.max(0, searchActive)]) {
          e.preventDefault();
          items[Math.max(0, searchActive)].click();
        }
      } else if (e.key === 'Escape') {
        clearSearch();
        searchInput.blur();
      }
    });
    searchInput.addEventListener('blur', () => {
      // Allow click on a result to land before hiding.
      window.setTimeout(() => {
        if (!root.contains(document.activeElement)) {
          searchResults.hidden = true;
          applySearchFilter('');
        }
      }, 120);
    });
  }

  // Control buttons.
  const fsBtn = root.querySelector<HTMLButtonElement>('[data-kg-action="fullscreen"]');
  root.querySelectorAll<HTMLButtonElement>('[data-kg-action]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const action = btn.dataset.kgAction;
      const center = { x: world.w / 2, y: world.h / 2 };
      if (action === 'zoom-in') {
        vp = zoomAt(vp, center, 1.35, world);
        applyViewport();
      } else if (action === 'zoom-out') {
        vp = zoomAt(vp, center, 1 / 1.35, world);
        applyViewport();
      } else if (action === 'reset') {
        resetViewport();
        if (restart) restart();
      } else if (action === 'fullscreen') {
        toggleFullscreen();
      } else if (action === 'toggle-color') {
        mode = mode === 'group' ? 'community' : 'group';
        const isCommunity = mode === 'community';
        btn.setAttribute('aria-pressed', String(isCommunity));
        btn.textContent = isCommunity ? btn.dataset.labelCommunity! : btn.dataset.labelGroup!;
        btn.title = btn.textContent;
        // Community mode has no group chips — reset the filter so nothing
        // stays hidden when switching back.
        hiddenGroups.clear();
        nodes.forEach((n, i) => {
          const circle = nodeEls[i].querySelector('circle');
          if (circle) circle.setAttribute('fill', colorFor(n));
        });
        renderLegend();
        applyGroupFilter();
      } else if (action === 'toggle-arrows') {
        showArrows = !showArrows;
        btn.setAttribute('aria-pressed', String(showArrows));
        edges.forEach((e, i) => {
          const l = links[i];
          if (showArrows && isDirected(l.type)) {
            e.setAttribute('marker-end', 'url(#kg-arrow)');
          } else {
            e.removeAttribute('marker-end');
          }
        });
      }
    });
  });

  function toggleFullscreen() {
    const isFs = root.classList.toggle('kg-fullscreen');
    if (fsBtn) {
      fsBtn.setAttribute('aria-label', isFs ? fsBtn.dataset.labelFsExit! : fsBtn.dataset.labelFs!);
      fsBtn.title = isFs ? fsBtn.dataset.labelFsExit! : fsBtn.dataset.labelFs!;
    }
    requestAnimationFrame(resetViewport);
  }

  // --- Load ---
  function load() {
    const url = src as string;
    fetch(url)
      .then((r) => r.json())
      .then((data) => {
        const rawNodes: any[] = (data as any).nodes ?? [];
        const communityIds = new Set<number>();
        communityLabels = new Map<number, string>();
        for (const n of rawNodes) {
          const c = (n as any).community ?? 0;
          communityIds.add(c);
          if (!communityLabels.has(c)) {
            communityLabels.set(c, (n as any).communityLabel ?? `#${c}`);
          }
        }
        communities = [...communityIds].sort((a, b) => a - b);
        renderLegend();
        // Build adjacency once before rendering.
        adjacency.clear();
        for (const l of data.links) {
          if (!adjacency.has(l.source)) adjacency.set(l.source, new Set());
          if (!adjacency.has(l.target)) adjacency.set(l.target, new Set());
          adjacency.get(l.source)!.add(l.target);
          adjacency.get(l.target)!.add(l.source);
        }
        reduced ? renderStatic(data) : renderForce(data);
      })
      .catch(() => {
        const isEn = document.documentElement.lang === 'en';
        svg.textContent = isEn ? 'Graph unavailable' : 'Граф недоступен';
      });
  }

  // Start when visible (lazy).
  if (reduced) {
    load();
  } else {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        load();
      }
    }, { threshold: 0.15 });
    io.observe(root);
  }
</script>


---
// Privacy-friendly analytics. Inert until env vars are set at build time.
// Set in CI secrets (baked into static HTML at build) or a local .env.
//
// Plausible:
//   PUBLIC_PLAUSIBLE_DOMAIN  e.g. "nikitaboyarkin.github.io"
//   PUBLIC_PLAUSIBLE_SRC     optional custom/self-hosted script URL
//                            (default https://plausible.io/js/script.js)
// PostHog:
//   PUBLIC_POSTHOG_KEY       project token (<ph_project_token>)
//   PUBLIC_POSTHOG_HOST      default https://us.i.posthog.com (EU: https://eu.i.posthog.com)
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const plausibleSrc =
  import.meta.env.PUBLIC_PLAUSIBLE_SRC || 'https://plausible.io/js/script.js';
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;
---

{plausibleDomain && <script defer data-domain={plausibleDomain} src={plausibleSrc} is:inline></script>}

{posthogKey && (
  <script>
    import { posthog } from 'posthog-js';

    posthog.init(import.meta.env.PUBLIC_POSTHOG_KEY, {
      api_host: import.meta.env.PUBLIC_POSTHOG_HOST || 'https://us.i.posthog.com',
      defaults: '2026-05-30',
      capture_pageview: true,
      capture_pageleave: true,
      autocapture: true,
      session_recording: { mask_all_inputs: true },
    });
  </script>
)}

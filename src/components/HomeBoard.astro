---
import ProjectSpotlight from './ProjectSpotlight.astro';
import ArrowMorph from './ArrowMorph.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/path';
import { METRICS as SIG } from '../lib/metrics';

interface Props {
  lang?: 'ru' | 'en';
}
const { lang = 'ru' } = Astro.props;
const isEn = lang === 'en';

const projectCollection = isEn ? 'projects-en' : 'projects';
const linkPrefix = isEn ? 'en/' : '';
const allProjects = await getCollection(projectCollection, (p) => !p.data.draft);

const t = {
  profile: isEn ? 'Profile' : 'Профиль',
  about: isEn ? 'About me' : 'Обо мне',
  metricsLabel: isEn ? 'Metrics' : 'Метрики',
  contact: isEn ? 'Contact' : 'Контакты',
  projects: isEn ? 'Projects' : 'Проекты',
  now: isEn ? 'In progress' : 'Сейчас в работе',
  more: isEn ? 'More →' : 'Подробнее →',
  telegram: '@lofinibo',
  github: 'github.com/NikitaBoyarkin',
  linkedin: 'linkedin.com/in/nikita-boyarkin',
  openTo: isEn
    ? 'Open to Data / Product Analyst roles.'
    : 'Открыт к Data / Product Analyst ролям.',
  thesis: isEn
    ? 'I help product teams make decisions on data: A/B tests with reproducible methodology (CUPED, AA-tests, Bonferroni, ship-gates), retention analytics, and SQL dashboards that don\u2019t lie.'
    : 'Помогаю продуктовым командам принимать решения на данных: A/B-тесты с воспроизводимой методологией (CUPED, AA-тесты, Bonferroni, ship-gates), retention-аналитика и SQL-дашборды, которые не врут.',
  experience: isEn
    ? '4+ years at the intersection of product, data, and experimentation. Synthetic data, real methodology.'
    : '4+ года на стыке продукта, данных и экспериментов. Синтетика — методология боевая.',
  nowItems: isEn
    ? [
        'Preparing for BI / Data Analyst and Product Analyst mid-level interviews: SQL, pandas, algorithms, mocks.',
        'Maintaining an Obsidian knowledge base on product analytics — a structured Zettelkasten with automation.',
        'Experimenting with AI-assisted analytics workflows on Claude Code + MCP.',
      ]
    : [
        'Готовлюсь к BI / Data Analyst и Product Analyst middle-интервью: SQL, pandas, алгоритмы, моки.',
        'Развиваю Obsidian knowledge base по product-аналитике — структурированный Zettelkasten с автоматизацией.',
        'Экспериментирую с AI-assisted аналитическими workflow на Claude Code + MCP.',
      ],
  metrics: [
    { value: String(allProjects.length), label: isEn ? 'projects in portfolio' : 'проектов в портфолио' },
    { value: '10', label: isEn ? 'SQL cases on DuckDB' : 'SQL-кейсов на DuckDB' },
    { value: `+${SIG.abKyc.deltaPp}pp`, label: isEn ? 'KYC conversion' : 'KYC-конверсия' },
    { value: `€${SIG.abKyc.annualEurK}K/yr`, label: isEn ? 'annual fix impact' : 'годовой эффект фикса' },
  ],
  timeline: isEn ? 'Path & timeline' : 'Путь и таймлайн',
  arcade: isEn ? 'Games arcade' : 'Аркада игр',
  graph: isEn ? 'Knowledge graph' : 'Граф знаний',
  nowCta: isEn ? 'Chat on Telegram' : 'Написать в Telegram',
};

const nowHref = withBase('now/'); // now stays RU-only
const timelineHref = '#path';
const arcadeHref = withBase('games/');
const graphHref = withBase(isEn ? 'en/graph/' : 'graph/');
const contactHref = withBase('contact/');
---

<section id="board" class="reveal reveal-delay-1" aria-label={t.projects}>
  <h2 class="visually-hidden">{t.projects}</h2>
  <div
    id="page-board"
    tabindex="0"
    role="region"
    aria-label={isEn ? 'Portfolio board: Profile, Projects, In progress' : 'Доска портфолио: Профиль, Проекты, Сейчас в работе'}
  >
    <!-- Профиль -->
    <div class="kanban-column kanban-column-sticky">
      <div class="kanban-column-header">
        <span class="kanban-column-title">{t.profile}</span>
      </div>
      <div class="kanban-column-body">
        <div class="board-card board-card-photo">
          <picture>
            <source type="image/webp" srcset={withBase('images/00_profile.webp')} />
            <img
              src={withBase('images/00_profile.jpg')}
              alt="Nikita Boyarkin"
              width="800"
              height="792"
              loading="eager"
              fetchpriority="high"
            />
          </picture>
        </div>

        <div class="board-card">
          <h3 class="board-card-title">{t.about}</h3>
          <p class="board-card-text">{t.thesis}</p>
          <p class="board-card-text board-card-experience">{t.experience}</p>
          <p class="board-card-open-to">{t.openTo}</p>
          <a class="board-card-link" href={withBase(isEn ? 'en/about/' : 'about/')}>{t.more}</a>
        </div>

        <div class="board-card">
          <h3 class="board-card-title">{t.metricsLabel}</h3>
          <div class="board-metrics">
            {t.metrics.map((m) => (
              <div class="board-metric">
                <div class="board-metric-value">{m.value}</div>
                <div class="board-metric-label">{m.label}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="board-card">
          <h3 class="board-card-title">{t.contact}</h3>
          <ul class="board-links">
            <li><a href="https://t.me/lofinibo" data-analytics="telegram_board" target="_blank" rel="noopener noreferrer">{t.telegram}</a></li>
            <li><a href="https://github.com/NikitaBoyarkin" data-analytics="github_board" target="_blank" rel="noopener noreferrer">{t.github}</a></li>
            <li><a href="https://www.linkedin.com/in/nikita-boyarkin" data-analytics="linkedin_board" target="_blank" rel="noopener noreferrer">{t.linkedin}</a></li>
            <li><a href={contactHref}>{isEn ? 'Contact page' : 'Страница контактов'}</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Проекты -->
    <div id="projects" class="kanban-column kanban-column-projects">
      <div class="kanban-column-header">
        <span class="kanban-column-title">{t.projects}</span>
        <span class="kanban-column-count">{allProjects.length}</span>
      </div>
      <div class="kanban-column-body kanban-project-body">
        <ProjectSpotlight collection={projectCollection} linkPrefix={linkPrefix} />
      </div>
    </div>

    <!-- Сейчас в работе -->
    <div class="kanban-column kanban-column-sticky">
      <div class="kanban-column-header">
        <span class="kanban-column-title">{t.now}</span>
        <span class="kanban-column-count">{t.nowItems.length}</span>
      </div>
      <div class="kanban-column-body">
        <ul class="now-list">
          {t.nowItems.map((item) => (
            <li class="now-item">
              <span class="now-dot"></span>
              {item}
            </li>
          ))}
        </ul>

        <div class="board-card">
          <p class="board-card-text">{isEn ? 'Full "now" page:' : 'Полная страница «сейчас»:'}</p>
          <a class="board-card-link" href={nowHref}>{t.more}</a>
        </div>

        <div class="board-card">
          <h3 class="board-card-title">{isEn ? 'Explore' : 'Исследуй'}</h3>
          <ul class="board-links">
            <li><a href={timelineHref}>{t.timeline}</a></li>
            <li><a href={arcadeHref}>{t.arcade}</a></li>
            <li><a href={graphHref}>{t.graph}</a></li>
          </ul>
        </div>

        <p class="now-teaser-cta">
          <a class="button" href="https://t.me/lofinibo" target="_blank" rel="noopener noreferrer">{t.nowCta} <ArrowMorph /></a>
        </p>
      </div>
    </div>
  </div>
</section>
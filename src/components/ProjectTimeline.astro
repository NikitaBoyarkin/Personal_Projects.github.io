---
// Numbered project-path timeline on the homepage — the reference site
// (daryabuchakova.com) shows a numbered "Опыт работы" list with quantified
// outcomes. This mirrors that structure but stays honest: it tracks the
// portfolio path (projects), not employer history.
// Top projects come from the same ORDER used by ProjectBoard/ProjectSpotlight.
import { getCollection } from 'astro:content';
import { withBase } from '../lib/path';

interface Props {
  lang?: 'ru' | 'en';
}
const { lang = 'ru' } = Astro.props;
const isEn = lang === 'en';
const collection = isEn ? 'projects-en' : 'projects';
const linkPrefix = isEn ? 'en/' : '';

const I18N = {
  heading: isEn ? 'Project path' : 'Путь проектов',
  lead: isEn
    ? 'From hypothesis to ship-gate — the portfolio told as a sequence.'
    : 'От гипотезы до ship-gate — портфолио как последовательность.',
  role: isEn ? 'Product / Data Analyst' : 'Product / Data Analyst',
  impact: isEn ? 'Impact' : 'Эффект',
  open: isEn ? 'Open' : 'Открыть',
};

const ORDER = ['volta', 'ab', 'supabase', 'posthog', 'streamlit', 'sales-calls', 'sql', 'rfm', 'cohort', 'bot', 'scrolly', 'garden', 'site'];
const SHOW = 6;

const projects = (await getCollection(collection, (p) => !p.data.draft))
  .map((p) => ({ ...p, slug: p.id.replace(/\.md$/, '') }))
  .sort((a, b) => ORDER.indexOf(a.slug) - ORDER.indexOf(b.slug))
  .filter((p) => ORDER.includes(p.slug))
  .slice(0, SHOW);
---

<section id="path" class="timeline reveal reveal-delay-1" aria-label={I18N.heading}>
  <h2>{I18N.heading}</h2>
  <p class="timeline-lead">{I18N.lead}</p>

  <ol class="timeline-list">
    {
      projects.map((p, i) => (
        <li class="timeline-item">
          <span class="timeline-num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div class="timeline-body">
            <h3>
              <a href={withBase(`${linkPrefix}projects/${p.slug}/`)}>{p.data.title}</a>
            </h3>
            <p class="timeline-meta">
              {I18N.role}
              {p.data.tools && p.data.tools.length > 0 && (
                <span class="timeline-tools"> · {p.data.tools.join(' · ')}</span>
              )}
            </p>
            <p class="timeline-desc">{p.data.description}</p>
            {p.data.impact && p.data.impact.length > 0 && (
              <ul class="timeline-impact">
                {p.data.impact.slice(0, 2).map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            <a class="timeline-link" href={withBase(`${linkPrefix}projects/${p.slug}/`)}>
              {I18N.open} →
            </a>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .timeline {
    margin: var(--space-16) 0;
  }
  .timeline h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: var(--space-3);
    color: var(--text-normal);
  }
  .timeline-lead {
    color: var(--text-muted);
    max-width: 60ch;
    margin-bottom: var(--space-10);
  }

  .timeline-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border-color);
    margin-left: 2rem;
  }
  .timeline-item {
    position: relative;
    padding: 0 0 var(--space-8) var(--space-8);
  }
  .timeline-item:last-child {
    padding-bottom: 0;
  }
  .timeline-num {
    position: absolute;
    left: -2rem;
    top: 0;
    width: 3.5rem;
    transform: translateX(-50%);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-accent);
    background: var(--background-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    padding: 0.2rem 0;
  }
  .timeline-body h3 {
    font-size: 1.25rem;
    margin: 0 0 var(--space-2);
  }
  .timeline-body h3 a {
    color: var(--text-normal);
    text-decoration: none;
    background-image: linear-gradient(var(--text-accent), var(--text-accent));
    background-repeat: no-repeat;
    background-size: 0% 2px;
    background-position: 0 100%;
    transition: background-size 0.25s ease;
  }
  .timeline-body h3 a:hover {
    background-size: 100% 2px;
  }
  .timeline-meta {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
    margin: 0 0 var(--space-2);
  }
  .timeline-tools {
    color: var(--text-muted);
  }
  .timeline-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 var(--space-4);
    max-width: 62ch;
  }
  .timeline-impact {
    margin: 0 0 var(--space-3);
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .timeline-impact li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--text-normal);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .timeline-impact li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--text-accent);
  }
  .timeline-link {
    color: var(--text-accent);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .timeline-link:hover {
    color: var(--text-accent-hover);
  }

  @media (max-width: 640px) {
    .timeline-list {
      margin-left: 1.25rem;
    }
    .timeline-item {
      padding-left: var(--space-6);
    }
    .timeline-num {
      left: -1.25rem;
      width: 2.5rem;
    }
  }
</style>

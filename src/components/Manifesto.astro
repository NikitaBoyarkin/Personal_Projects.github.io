---
// Word-by-word typographic manifesto — the site's core positioning statement,
// revealed progressively on scroll. Adapted from daryabuchakova.com's
// "Создаю не просто дизайн, а систему..." editorial section.
interface Props {
  lang?: 'ru' | 'en';
}
const { lang = 'ru' } = Astro.props;

const I18N = {
  ru: {
    statement:
      'Не просто дашборды — система решений. Каждая метрика отвечает на вопрос продукта, каждый эксперимент проходит ship-gate, и данные говорят единым голосом.',
    strong: ['дашборды', 'решений', 'метрика', 'ship-gate', 'единым'],
  },
  en: {
    statement:
      'Not just dashboards — a decision system. Every metric answers a product question, every experiment passes the ship-gate, and data speaks with one voice.',
    strong: ['dashboards', 'decision', 'metric', 'ship-gate', 'voice'],
  },
};

const t = I18N[lang];
const words = t.statement.split(' ').map((w) => ({
  w,
  strong: t.strong.some((s) => w.toLowerCase().replace(/[.,:;»«—\-]/g, '').includes(s.toLowerCase())),
}));
---

<section id="manifesto" class="manifesto reveal" aria-label={lang === 'en' ? 'Positioning' : 'Позиционирование'}>
  <p class="manifesto-text">
    {
      words.map(({ w, strong }) => (
        <span class:list={['w', { 'w-strong': strong }]}>{w}</span>
      ))
    }
  </p>
</section>

<script>
  const el = document.querySelector('.manifesto');
  if (el) {
    // Gate the hidden state behind .js so the statement stays readable
    // without JavaScript (no-JS fallback).
    document.documentElement.classList.add('js');
    const words = el.querySelectorAll('.w');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            io.disconnect();
            words.forEach((w, i) => {
              setTimeout(() => w.classList.add('w-revealed'), i * 45);
            });
          }
        }
      },
      { threshold: 0.25 },
    );
    io.observe(el);
  }
</script>

<style>
  .manifesto {
    margin: var(--space-16) auto;
    padding: var(--space-12) var(--space-6);
    max-width: 72ch;
    text-align: center;
  }
  .manifesto-text {
    font-size: clamp(1.6rem, 3.2vw, 2.6rem);
    font-weight: 650;
    line-height: 1.4;
    color: var(--text-normal);
    letter-spacing: -0.01em;
  }
  .w {
    display: inline-block;
    /* Fully visible by default so the statement is readable without JS;
       the hidden state is scoped under .js (added by the script). */
    opacity: 1;
    transform: none;
  }
  .w-strong {
    color: var(--text-accent);
  }
  .js .w {
    opacity: 0.15;
    transform: translateY(6px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  .js .w-revealed {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .js .w {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

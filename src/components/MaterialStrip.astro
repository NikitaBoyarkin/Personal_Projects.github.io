---
// "New materials" strip — horizontal scroll-snap of thumbnail cards (latest
// posts + the featured Volta project), inspired by podbiratel's material
// strip. Replaces the text-only blog list on the homepage.
// `lang="en"` pulls the EN project collection + EN labels; posts stay RU (no
// EN posts yet) — matches the pre-existing EN-home behaviour.
import { getCollection } from "astro:content";
import { withBase } from "../lib/path";
import { formatDate } from "../lib/date";
import { categoryLabel } from "../lib/categories";
import { PROJECT_ORDER, projectTracks } from "../lib/projects";

interface Props {
  lang?: "ru" | "en";
}
const { lang = "ru" } = Astro.props;
const isEn = lang === "en";

const projectCollection = isEn ? "projects-en" : "projects";
const postCollection = isEn ? "posts-en" : "posts";
const linkPrefix = isEn ? "en/" : "";
const postLinkPrefix = isEn ? "en/" : "";
const heading = isEn ? "Fresh materials" : "Свежие материалы";
const projectBadge = isEn ? "Project" : "Проект";
const footLabel = isEn ? "All writing" : "Все записи";
const row2Heading = isEn ? "More projects" : "Ещё проекты";

const posts = (await getCollection(postCollection, (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const projects = await getCollection(projectCollection, (p) => !p.data.draft);
const volta = projects.find((p) => p.id.replace(/\.md$/, "") === "volta");

const slugOf = (id: string) => id.replace(/\.md$/, "");
// WebP sibling for lazy previews (PNG stays for OG meta tags).
const webpOf = (src: string) => src.replace(/\.png$/, ".webp");

// Row 2 — non-featured projects in canonical order (PROJECT_ORDER) with a
// track badge, so recruiters/colleagues see breadth past Volta.
const trackLabels = new Map(projectTracks(isEn ? "en" : "ru").map((t) => [t.key, t.label]));
const orderRank = (id: string) => {
  const i = PROJECT_ORDER.indexOf(id);
  return i === -1 ? Number.MAX_SAFE_INTEGER : i;
};
const rowProjects = projects
  .map((p) => ({ p, id: slugOf(p.id) }))
  .filter(({ p, id }) => id !== "volta" && !p.data.private)
  .sort((a, b) => orderRank(a.id) - orderRank(b.id));
const impactOf = (p: (typeof projects)[number]) =>
  (p.data.impact[0] || p.data.description).slice(0, 72);
---

<section id="materials" class="reveal reveal-delay-1" aria-label={heading}>
  <h2>{heading}</h2>
  <div class="material-strip">
    {
      volta && (
        <a class="strip-card strip-card-featured" href={withBase(`${linkPrefix}projects/volta/`)}>
          {volta.data.hero && (
            <img
              src={withBase(volta.data.hero)}
              alt={volta.data.title}
              width="600"
              height="200"
              loading="lazy"
            />
          )}
          <div class="strip-card-body">
            <span class="strip-badge strip-badge-project">{projectBadge}</span>
            <span class="strip-title">{volta.data.title}</span>
            <span class="strip-meta">{volta.data.description.slice(0, 72)}…</span>
          </div>
        </a>
      )
    }
    {
      posts.map((post) => (
        <a class="strip-card" href={withBase(`${postLinkPrefix}posts/${slugOf(post.id)}/`)}>
          {post.data.image && (
            <picture>
              <source type="image/webp" srcset={withBase(webpOf(post.data.image))} />
              <img
                src={withBase(post.data.image)}
                alt={post.data.title}
                width="600"
                height="200"
                loading="lazy"
              />
            </picture>
          )}
          <div class="strip-card-body">
            <span class="strip-badge strip-badge-post">
              {categoryLabel(post.data.category, lang)}
            </span>
            <span class="strip-title">{post.data.title}</span>
            <span class="strip-meta">{formatDate(post.data.date)}</span>
          </div>
        </a>
      ))
    }
  </div>

  {
    rowProjects.length > 0 && (
      <>
        <p class="project-row-heading">{row2Heading}</p>
        <div class="material-strip project-strip">
          {
            rowProjects.map(({ p, id }) => (
              <a class="strip-card" href={withBase(`${linkPrefix}projects/${id}/`)}>
                <div class="strip-card-body">
                  <span class="strip-badge strip-badge-track" data-track={p.data.track}>
                    {trackLabels.get(p.data.track) || p.data.track}
                  </span>
                  <span class="strip-title">{p.data.title}</span>
                  <span class="strip-meta">{impactOf(p)}…</span>
                </div>
              </a>
            ))
          }
        </div>
      </>
    )
  }

  <p class="strip-foot">
    <a href={withBase(`${isEn ? 'en/' : ''}writing/`)}>{footLabel} →</a>
  </p>
</section>

<style>
  .project-row-heading {
    margin: var(--space-6) 0 var(--space-2);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
</style>
---
// Site-wide search island. Bundled (type-checked) script — no framework, no
// client directive. The index URL, i18n strings and topic suggestions are
// stamped server-side via data attributes so the client never touches
// import.meta.env. Styles live in global.css (.search-*).
import { withBase } from "../lib/path";
import { TOPICS } from "../lib/topics";

interface Props {
  lang?: "ru" | "en";
}
const { lang = "ru" } = Astro.props;
const isEn = lang === "en";

const indexUrl = withBase("search-index.json");
const topicLinks = TOPICS.map((t) => ({ l: t.label, h: withBase(`topics/${t.key}/`) }));

const i18n = {
  placeholder: isEn ? "Search projects & writing…" : "Поиск по проектам и записям…",
  hint: isEn ? "↑↓ navigate · Enter open · Esc close" : "↑↓ навигация · Enter перейти · Esc закрыть",
  all: isEn ? "All" : "Все",
  projects: isEn ? "Projects" : "Проекты",
  posts: isEn ? "Posts" : "Записи",
  empty: isEn ? "Nothing found" : "Ничего не найдено",
  topicsLabel: isEn ? "Browse topics:" : "Смотрите темы:",
  toggleLabel: isEn ? "Open search" : "Открыть поиск",
  facetsLabel: isEn ? "Filter by type" : "Фильтр по типу",
  resultsLabel: isEn ? "Search results" : "Результаты поиска",
};
---

<div
  class="search"
  data-index-url={indexUrl}
  data-topics={JSON.stringify(topicLinks)}
  data-i18n={JSON.stringify(i18n)}
>
  <button
    id="search-toggle"
    class="search-toggle"
    type="button"
    aria-label={i18n.toggleLabel}
    aria-expanded="false"
    aria-controls="search-panel"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="7" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>
  </button>

  <div id="search-panel" class="search-panel" hidden>
    <input
      id="search-input"
      class="search-input"
      type="search"
      placeholder={i18n.placeholder}
      autocomplete="off"
      role="combobox"
      aria-expanded="false"
      aria-controls="search-results"
      aria-autocomplete="list"
    />
    <div class="search-facets" role="group" aria-label={i18n.facetsLabel}>
      <button class="search-facet is-active" data-facet="all" type="button">{i18n.all}</button>
      <button class="search-facet" data-facet="project" type="button">{i18n.projects}</button>
      <button class="search-facet" data-facet="post" type="button">{i18n.posts}</button>
    </div>
    <ul id="search-results" class="search-results" role="listbox" aria-label={i18n.resultsLabel}></ul>
    <p class="search-hint">{i18n.hint}</p>
  </div>
</div>

<script>
  // Wrap in init() — ES module top-level `return` is illegal, so all early
  // bail-outs live inside a function.
  function init() {
    const root = document.querySelector<HTMLElement>(".search");
    if (!root) return;
    const indexUrl = root.dataset.indexUrl!;
    const topics: { l: string; h: string }[] = JSON.parse(root.dataset.topics || "[]");
    type I18n = {
      placeholder: string;
      hint: string;
      all: string;
      projects: string;
      posts: string;
      empty: string;
      topicsLabel: string;
      toggleLabel: string;
      facetsLabel: string;
      resultsLabel: string;
    };
    const t: I18n = JSON.parse(root.dataset.i18n || "{}");
    const toggleEl = document.getElementById("search-toggle");
    const panelEl = document.getElementById("search-panel");
    const inputEl = document.getElementById("search-input") as HTMLInputElement | null;
    const resultsElEl = document.getElementById("search-results");
    const facetEls = root.querySelectorAll<HTMLButtonElement>(".search-facet");
    if (!toggleEl || !panelEl || !inputEl || !resultsElEl || !indexUrl) return;
    // Reassign to const so TS keeps the non-null narrowing inside closures.
    const toggle = toggleEl;
    const panel = panelEl;
    const input = inputEl;
    const resultsEl = resultsElEl;

    const lang = document.documentElement.lang === "en" ? "en" : "ru";
    const typeLabel = (tp: string) =>
      lang === "en" ? (tp === "post" ? "Post" : "Project") : (tp === "post" ? "Запись" : "Проект");

    type Entry = {
      type: string;
      locale: string;
      title: string;
      desc: string;
      tags?: string[];
      tools?: string[];
      href: string;
      date?: string;
    };
    let index: Entry[] | null = null;
    let activeIndex = -1;
    let facet = "all";

    async function getIndex() {
      if (!index) {
        const res = await fetch(indexUrl);
        index = (await res.json()) as Entry[];
      }
      return index;
    }

    function open() {
      panel.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
      input.focus();
    }

    function close() {
      panel.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      input.value = "";
      resultsEl.innerHTML = "";
      input.setAttribute("aria-expanded", "false");
      activeIndex = -1;
      setFacet("all");
    }

    function setFacet(next: string) {
      facet = next;
      facetEls.forEach((b) => b.classList.toggle("is-active", b.dataset.facet === next));
    }

    function escapeHtml(s: string): string {
      return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function highlight(text: string, tokens: string[]): string {
      const esc = escapeHtml(text);
      const toks = tokens.filter(Boolean);
      if (!toks.length) return esc;
      const re = new RegExp(
        "(" + toks.map((tk) => tk.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|") + ")",
        "gi",
      );
      return esc.replace(re, "<mark>$1</mark>");
    }

    function score(entry: Entry, tokens: string[]): number {
      const hay = (
        entry.title +
        " " +
        entry.desc +
        " " +
        (entry.tags ?? []).join(" ") +
        " " +
        (entry.tools ?? []).join(" ")
      ).toLowerCase();
      let s = 0;
      for (const tk of tokens) {
        if (!hay.includes(tk)) return -1;
        s += entry.title.toLowerCase().includes(tk) ? 3 : 0;
        s += (entry.tags ?? []).some((tag) => tag.toLowerCase() === tk) ? 2 : 0;
        s += 1;
      }
      return s;
    }

    function render(rows: Entry[], tokens: string[]) {
      resultsEl.innerHTML = "";
      if (!rows.length) {
        const li = document.createElement("li");
        li.className = "search-empty";
        const label = document.createElement("span");
        label.textContent = t.empty;
        li.appendChild(label);
        if (topics.length) {
          const wrap = document.createElement("div");
          wrap.className = "search-topics";
          const cap = document.createElement("span");
          cap.className = "search-topics-label";
          cap.textContent = t.topicsLabel;
          wrap.appendChild(cap);
          topics.forEach((tp) => {
            const a = document.createElement("a");
            a.href = tp.h;
            a.className = "search-topic-chip";
            a.textContent = tp.l;
            wrap.appendChild(a);
          });
          li.appendChild(wrap);
        }
        resultsEl.appendChild(li);
        input.setAttribute("aria-expanded", "false");
        activeIndex = -1;
        return;
      }
      input.setAttribute("aria-expanded", "true");
      rows.forEach((r, i) => {
        const li = document.createElement("li");
        li.className = "search-result";
        li.setAttribute("role", "option");
        li.dataset.idx = String(i);

        const a = document.createElement("a");
        a.href = r.href;
        a.tabIndex = -1;

        const type = document.createElement("span");
        type.className = "search-result-type";
        type.textContent = typeLabel(r.type);

        const title = document.createElement("span");
        title.className = "search-result-title";
        title.innerHTML = highlight(r.title, tokens);

        a.appendChild(type);
        a.appendChild(title);

        if (r.desc) {
          const d = document.createElement("span");
          d.className = "search-result-desc";
          d.innerHTML = highlight(r.desc, tokens);
          a.appendChild(d);
        }

        li.appendChild(a);
        resultsEl.appendChild(li);
      });
      activeIndex = -1;
    }

    let debounce: ReturnType<typeof setTimeout> | undefined;
    async function runSearch() {
      const idx = await getIndex();
      if (!idx) return;
      const q = input.value.trim().toLowerCase();
      const tokens = q ? q.split(/\s+/).filter(Boolean) : [];
      let rows: Entry[];
      if (!q) {
        // No query + active facet → browse recent items of that type.
        if (facet === "all") {
          resultsEl.innerHTML = "";
          input.setAttribute("aria-expanded", "false");
          activeIndex = -1;
          return;
        }
        rows = idx
          .filter((e) => e.locale === lang && e.type === facet)
          .sort((a, b) => (b.date ?? "").localeCompare(a.date ?? ""))
          .slice(0, 8);
      } else {
        rows = idx
          .filter((e) => e.locale === lang && (facet === "all" || e.type === facet))
          .map((e) => ({ e, s: score(e, tokens) }))
          .filter((x) => x.s >= 0)
          .sort((a, b) => b.s - a.s)
          .slice(0, 8)
          .map((x) => x.e);
      }
      render(rows, tokens);
    }

    input.addEventListener("input", () => {
      clearTimeout(debounce);
      debounce = setTimeout(runSearch, 120);
    });

    facetEls.forEach((b) => {
      b.addEventListener("click", () => {
        setFacet(b.dataset.facet || "all");
        runSearch();
        input.focus();
      });
    });

    function move(delta: number) {
      const items = resultsEl.querySelectorAll<HTMLElement>(".search-result");
      if (!items.length) return;
      activeIndex = (activeIndex + delta + items.length) % items.length;
      items.forEach((it, i) => it.classList.toggle("active", i === activeIndex));
      items[activeIndex].scrollIntoView({ block: "nearest" });
    }

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        move(1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        move(-1);
      } else if (e.key === "Enter") {
        const items = resultsEl.querySelectorAll<HTMLElement>(".search-result");
        if (activeIndex >= 0 && items[activeIndex]) {
          const a = items[activeIndex].querySelector("a");
          if (a) {
            e.preventDefault();
            window.location.href = a.href;
          }
        }
      } else if (e.key === "Escape") {
        close();
      }
    });

    toggle.addEventListener("click", () => {
      panel.hidden ? open() : close();
    });

    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) close();
    });

    document.addEventListener("keydown", (e) => {
      const el = document.activeElement;
      const typing = el && (el.tagName === "INPUT" || el.tagName === "TEXTAREA");
      if (e.key === "/" && !typing) {
        e.preventDefault();
        open();
      }
    });
  }

  init();
</script>
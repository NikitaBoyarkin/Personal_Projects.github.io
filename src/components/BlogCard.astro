---
import { withBase } from '../lib/path';
import { formatDate } from '../lib/date';
import { categoryLabel } from '../lib/categories';

interface Props {
  slug: string;
  title: string;
  category: string;
  date: Date;
  excerpt: string;
  image?: string;
  updated?: Date;
  readTime?: number;
  lang?: 'ru' | 'en';
}

const { slug, title, category, date, excerpt, image, updated, readTime, lang = 'ru' } = Astro.props;
const minLabel = lang === 'en' ? 'min' : 'мин';
const updatedText = updated
  ? lang === 'en'
    ? `updated ${formatDate(updated)}`
    : `обновлено ${formatDate(updated)}`
  : null;
---

<a href={withBase(`posts/${slug}/`)} class="blog-card" data-category={category}>
  {
    image && (
      <img
        class="blog-card-image"
        src={withBase(image)}
        alt=""
        width="600"
        height="200"
        loading="lazy"
      />
    )
  }
  <div class="blog-card-body">
    <span class="blog-card-tag">{categoryLabel(category, lang)}</span>
    <div class="blog-card-title">{title}</div>
    <div class="blog-card-meta">
      {formatDate(date)}{readTime ? ` · ${readTime} ${minLabel}` : ''}
    </div>
    {
      updatedText && (
        <span class="blog-card-updated" aria-label={updatedText}>
          {updatedText}
        </span>
      )
    }
    <div class="blog-card-excerpt">{excerpt}</div>
  </div>
</a>
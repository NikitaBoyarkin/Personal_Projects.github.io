---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import { PROJECT_ORDER, projectTracks } from '../lib/projects';

interface Props {
  collection?: 'projects' | 'projects-en';
  linkPrefix?: string;
}
const { collection = 'projects', linkPrefix = '' } = Astro.props;
const lang: 'ru' | 'en' = linkPrefix.startsWith('en/') ? 'en' : 'ru';
const isEn = lang === 'en';

const TRACKS = projectTracks(lang);

const projects = (await getCollection(collection, (p) => !p.data.draft)).sort(
  (a, b) =>
    PROJECT_ORDER.indexOf(a.id.replace(/\.md$/, '')) -
    PROJECT_ORDER.indexOf(b.id.replace(/\.md$/, '')),
);

const byTrack = TRACKS.map((track) => ({
  ...track,
  projects: projects.filter((p) => p.data.track === track.key),
})).filter((track) => track.projects.length > 0);

const i18n = {
  tabs: isEn ? 'Project categories' : 'Категории проектов',
  previous: isEn ? 'Previous project' : 'Предыдущий проект',
  next: isEn ? 'Next project' : 'Следующий проект',
  project: isEn ? 'Project' : 'Проект',
};
---

<div id="project-spotlight" class="project-spotlight">
  <div class="spotlight-tabs" role="tablist" aria-label={i18n.tabs}>
    {
      byTrack.map((track, i) => (
        <button
          id={`spotlight-tab-${track.key}`}
          class={`spotlight-tab ${i === 0 ? 'active' : ''}`}
          role="tab"
          aria-selected={i === 0}
          aria-controls="spotlight-stage"
          data-category={track.key}
          tabindex={i === 0 ? 0 : -1}
          type="button"
        >
          {track.label}
          <span class="spotlight-tab-count">{track.projects.length}</span>
        </button>
      ))
    }
  </div>

  <div id="spotlight-stage" class="spotlight-stage" role="tabpanel" aria-labelledby={`spotlight-tab-${byTrack[0]?.key ?? ''}`}>
    {
      byTrack.map((track, tIdx) =>
        track.projects.map((project, idx) => {
          const active = tIdx === 0 && idx === 0;
          return (
            <div
              class="spotlight-slide"
              data-category={track.key}
              data-index={idx}
              hidden={!active}
            >
              <ProjectCard
                slug={project.id.replace(/\.md$/, '')}
                title={project.data.title}
                description={project.data.description}
                image={project.data.hero}
                impact={project.data.impact}
                tools={project.data.tools}
                github={project.data.github}
                demo={project.data.demo}
                private={project.data.private}
                linkPrefix={linkPrefix}
                lang={lang}
              />
            </div>
          );
        }),
      )
    }
  </div>

  <div class="spotlight-nav">
    <button class="spotlight-nav-btn spotlight-prev" type="button" aria-label={i18n.previous} disabled>
      ←
    </button>
    <span class="spotlight-progress" aria-live="polite">1 / {byTrack[0]?.projects.length ?? 0}</span>
    <button class="spotlight-nav-btn spotlight-next" type="button" aria-label={i18n.next} disabled>
      →
    </button>
  </div>
</div>

<script>
  const root = document.getElementById('project-spotlight');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.spotlight-tab'));
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.spotlight-slide'));
    const prevBtn = root.querySelector<HTMLButtonElement>('.spotlight-prev');
    const nextBtn = root.querySelector<HTMLButtonElement>('.spotlight-next');
    const progress = root.querySelector<HTMLElement>('.spotlight-progress');
    const stage = document.getElementById('spotlight-stage');

    const byCategory: Record<string, HTMLElement[]> = {};
    slides.forEach((slide) => {
      const cat = slide.dataset.category || '';
      (byCategory[cat] ||= []).push(slide);
    });

    let activeCat = tabs[0]?.dataset.category || '';
    let activeIdx = 0;

    function show() {
      tabs.forEach((tab) => {
        const on = tab.dataset.category === activeCat;
        tab.classList.toggle('active', on);
        tab.setAttribute('aria-selected', String(on));
        // Roving tabindex: only the active tab stays in the Tab order.
        tab.tabIndex = on ? 0 : -1;
      });
      slides.forEach((slide) => {
        const on = slide.dataset.category === activeCat && Number(slide.dataset.index) === activeIdx;
        slide.hidden = !on;
        if (on) {
          const card = slide.querySelector<HTMLElement>('.project');
          if (card) card.classList.add('visible');
        }
      });
      if (stage) {
        const activeTab = tabs.find((t) => t.dataset.category === activeCat);
        stage.setAttribute('aria-labelledby', activeTab ? activeTab.id : '');
      }
      const list = byCategory[activeCat] || [];
      if (progress) progress.textContent = `${activeIdx + 1} / ${list.length}`;
      const canCycle = list.length > 1;
      if (prevBtn) prevBtn.disabled = !canCycle;
      if (nextBtn) nextBtn.disabled = !canCycle;
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        activeCat = tab.dataset.category || activeCat;
        activeIdx = 0;
        show();
      });
    });

    prevBtn?.addEventListener('click', () => {
      const list = byCategory[activeCat] || [];
      activeIdx = (activeIdx - 1 + list.length) % list.length;
      show();
    });

    nextBtn?.addEventListener('click', () => {
      const list = byCategory[activeCat] || [];
      activeIdx = (activeIdx + 1) % list.length;
      show();
    });

    // Tablist arrow-key navigation.
    root.addEventListener('keydown', (e) => {
      if (!tabs.some((t) => t === document.activeElement)) return;
      const idx = tabs.findIndex((t) => t === document.activeElement);
      let next = -1;
      if (e.key === 'ArrowRight') next = (idx + 1) % tabs.length;
      else if (e.key === 'ArrowLeft') next = (idx - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = tabs.length - 1;
      if (next >= 0) {
        e.preventDefault();
        tabs[next].focus();
        tabs[next].click();
      }
    });

    show();
  }
</script>